---
import Base from '../layouts/Base.astro';
import { APP_STORE_URL } from '../consts';
import BookDemo from '../components/BookDemo.astro';
import { PLANS, MATRIX, REVERSE_TRIAL_DAYS, PAYMENT_TRIAL_DAYS } from '../plans';

const title = 'Pricing — QSortby for Shopify';
// Kept under ~155 characters so Google shows the whole thing rather than cutting
// mid-sentence. Same rule applies to every page's description.
const description = `Four plans from $0. Every install gets ${REVERSE_TRIAL_DAYS} days of full access, then settles on Free and keeps running. Billed through Shopify.`;

const check = '<svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg>';

// Turn a matrix cell into the right markup: ✓ / — get the yes/no treatment,
// everything else is literal text (a count, a window, "Docs"…).
const cellClass = (v: string) => (v === '✓' ? 'yes' : v === '—' ? 'no' : '');
---
<Base title={title} description={description} breadcrumb="Pricing">
  <section class="phero phero-mint">
    <div class="wrap">
      <h1>Start free. Stay free until it pays for itself.</h1>
      <p>
        Every install opens with <strong>{REVERSE_TRIAL_DAYS} days of full access</strong> — every feature,
        no card. After that you drop to the <strong>Free plan and keep running</strong>: real-time ranking,
        sold-out demotion and revenue attribution never switch off. Upgrade when the numbers in your own
        dashboard say it's worth it.
      </p>
    </div>
  </section>

  <section class="sec" style="padding-top:2rem">
    <div class="wrap">
      <div class="plans plans-4">
        {PLANS.map((p) => (
          <div class={p.feat ? 'plan feat rv' : 'plan rv'}>
            {p.badge && <span class="badge">{p.badge}</span>}
            <span class="ptag">{p.name}</span>
            <div class="price"><b>{p.price}</b><span>/ month</span></div>
            <p class="pdesc">{p.desc}</p>
            <ul>
              {p.features.map((f) => <li><span set:html={check} /> {f}</li>)}
            </ul>
            {p.cta === 'demo' ? (
              <BookDemo class="btn btn-accent w-full">Talk to us</BookDemo>
            ) : (
              <a href={APP_STORE_URL} class={p.feat ? 'btn btn-accent w-full' : 'btn btn-line w-full'}>
                {p.price === '$0' ? 'Install free' : 'Start free'}
              </a>
            )}
          </div>
        ))}
      </div>

      <p class="snote" style="margin-top:2rem">
        Billed via Shopify · cancel anytime · paid plans include a {PAYMENT_TRIAL_DAYS}-day Shopify trial
      </p>
    </div>
  </section>

  <!-- comparison matrix -->
  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="shead ctr rv" style="margin-bottom:2rem">
        <h2>What's in each plan</h2>
      </div>
      <div class="rv" style="overflow-x:auto">
        <table class="matrix matrix-4">
          <thead>
            <tr>
              <th>Feature</th>
              {PLANS.map((p) => <th class={p.feat ? 'colhi' : ''}>{p.name}</th>)}
            </tr>
          </thead>
          <tbody>
            {MATRIX.map((row) => (
              <tr>
                <th>{row.label}</th>
                {row.cells.map((c, i) => (
                  <td class={[cellClass(c), PLANS[i].feat ? 'colhi' : ''].filter(Boolean).join(' ')}>{c}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="snote lt" style="margin-top:1.25rem">
        * Order limits are a nudge, not a wall. Cross them and ranking keeps running exactly as before —
        you'll just see an upgrade prompt in the dashboard. We never break a live storefront to sell a plan.
      </p>
    </div>
  </section>

  <!-- which plan -->
  <section class="sec" style="padding-top:0">
    <div class="narrow">
      <div class="shead ctr rv" style="margin-bottom:2rem">
        <h2>Pick by what you're trying to fix</h2>
      </div>
      <div class="faq rv">
        <details open><summary>“My collections are stale and I sort them by hand.”<span class="pm"></span></summary><div class="ans"><b>Free.</b> One collection that ranks itself in real time, demotes sold-out products, and reports the revenue it influenced. If that one collection lifts, you'll see it before you've paid anything.</div></details>
        <details><summary>“Different collections need different logic.”<span class="pm"></span></summary><div class="ans"><b>Starter — $29.</b> Five managed collections, per-category rankings, and short windows unlocked — down to an hour for trend-catching, where Free is held to a steadier seven days. Fixed windows too: last week, a set month, any two dates.</div></details>
        <details><summary>“I need to prove the lift to someone.”<span class="pm"></span></summary><div class="ans"><b>Pro — $99.</b> Unlimited collections plus full customer-event analytics and attribution reporting, so every sort comes with a funnel and a revenue figure. Also unlocks AI authoring — it drafts your taxonomy and sort logic for you.</div></details>
        <details><summary>“I want a bigger average order, not just a better sort.”<span class="pm"></span></summary><div class="ans"><b>Start on Free.</b> The cart upsell and the free-shipping progress bar are included at $0, and both are fed by the same live ranking — so what gets suggested is what's actually selling and in stock. <b>Starter</b> adds frequently-bought-together on the product page and a thank-you-page offer; <b>Pro</b> adds popups on any page with AND/OR rules for when they fire; <b>Growth</b> adds an offer inside checkout itself (Shopify Plus only) and lets the live session read choose the suggestions in the cart, popup, checkout and thank-you offers.</div></details>
        <details><summary>“I want each shopper to see a different storefront.”<span class="pm"></span></summary><div class="ans"><b>Growth — $199.</b> Intent AI applied live: each visit is read for why the shopper came, and the For You feed and four upsells can rank by it, with the Intent AI on/off test behind it so you can see what it earned. Pro gets a read-only view first — the mix of visits your store actually gets, storefront untouched — if you'd rather look before you apply. <a href="/features/intent-ai">How Intent AI works</a>.</div></details>
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="narrow">
      <div class="shead ctr rv" style="margin-bottom:2.5rem">
        <h2>How billing works</h2>
      </div>
      <div class="faq rv">
        <details><summary>What actually happens after the {REVERSE_TRIAL_DAYS} days?<span class="pm"></span></summary><div class="ans">Your plan becomes <b>Free</b> — automatically, with no card and no interruption. Ranking keeps running, your collections keep updating, attribution keeps reporting. You lose the paid features (extra collections, personalization, analytics), not the app. Nothing is deleted and nothing is switched off.</div></details>
        <details><summary>So there are two trials?<span class="pm"></span></summary><div class="ans">Yes, and they do different jobs — both {REVERSE_TRIAL_DAYS} days, so there's only one number to remember. The <b>full-access window</b> starts the moment you install: no card, no plan chosen. Separately, when you pick a <i>paid</i> plan, Shopify adds its own <b>{PAYMENT_TRIAL_DAYS}-day trial</b> before the first charge. They <b>stack</b> — subscribe on day {REVERSE_TRIAL_DAYS} of the first window and you're free through day {REVERSE_TRIAL_DAYS * 2}.</div></details>
        <details><summary>How am I charged?<span class="pm"></span></summary><div class="ans">Through Shopify's Billing API. The subscription appears on your regular Shopify invoice — no separate payment method, no off-platform charging. The Free plan never goes through billing at all.</div></details>
        <details><summary>What if I go over the order limit on Free or Starter?<span class="pm"></span></summary><div class="ans">Nothing breaks. The limit is a soft nudge: you'll see an upgrade prompt in the dashboard, and ranking continues serving your storefront untouched. Hard-capping orders would degrade a live collection your shoppers are browsing — we won't do that.</div></details>
        <details><summary>Can I switch plans?<span class="pm"></span></summary><div class="ans">Any time, up or down, from inside the app. Changes take effect on your next billing cycle.</div></details>
        <!-- The consequence of going DOWN belongs on the page where somebody is
             deciding to go up — that is the moment they are worried about it, and
             every plan page that omits it is asking for trust it has not earned.
             All three sentences are what the app actually does. -->
        <details><summary>What happens to my work if I move back down?<span class="pm"></span></summary><div class="ans"><b>Nothing is deleted.</b> Collections beyond your new plan's limit keep every setting exactly as you left them and simply stop updating &mdash; move back up and they carry on from where they were. Any order QSortby has already published stays live on your storefront: it was written to your own Shopify collection, so it is yours whatever plan you are on. Segment rules, product sets and past snapshots are kept, not cleared.</div></details>
        <details><summary>What if I uninstall?<span class="pm"></span></summary><div class="ans">Billing stops immediately. Any collections QSortby created stay in your store as normal Shopify collections — they simply stop updating.</div></details>
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="cta rv">
        <h2>Install free. Decide with <em>your own numbers.</em></h2>
        <p>{REVERSE_TRIAL_DAYS} days of everything, then Free forever. No card to start.</p>
        <div class="hero-cta" style="justify-content:center">
          <a href={APP_STORE_URL} class="btn btn-accent btn-lg">Install free <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          <BookDemo class="btn btn-ghost btn-lg">Book a demo</BookDemo>
        </div>
      </div>
    </div>
  </section>
</Base>
