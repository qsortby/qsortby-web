---
import Base from '../../layouts/Base.astro';
import { APP_STORE_URL } from '../../consts';
import BookDemo from '../../components/BookDemo.astro';
import UpsellHero from '../../components/UpsellHero.astro';
import UpsellFeatures from '../../components/UpsellFeatures.astro';

const title = 'Upsell AI — QSortby';
const description =
  'Upsell AI for Shopify: cart, pop-up, bought-together, free-shipping, checkout and thank-you offers learned from what your shoppers view, add and buy — rebuilt nightly, never sold out — and re-ranked by why each shopper came. Then an on/off test says whether it paid.';
---
<Base title={title} description={description} breadcrumb="Upsell AI">
  <section class="phero phero-mint">
    <div class="wrap herogrid">
      <div>
        <div class="crumb">Upsell AI</div>
        <h1>Offers learned from your shoppers, shown where they decide.</h1>
        <p>From the cart drawer to the thank-you page, every block can draw on what your shoppers actually view, add and buy together — rebuilt every night from your own store — and re-ranks it by why this visit came. Nothing sold out, nothing already in the cart.</p>
        <div class="hero-cta" style="margin-top:2rem">
          <a href={APP_STORE_URL} class="btn btn-accent btn-lg">Try it free <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>
      </div>
      <UpsellHero />
    </div>
  </section>

  <!-- ===================== HOW IT WORKS ===================== -->
  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="shead ctr rv" style="margin-bottom:2.5rem">
        <h2>How it works</h2>
      </div>
      <div class="steps">
        <div class="step rv"><div class="sn">01</div><h3>Pick a touchpoint</h3><p>Cart drawer, free-shipping bar, pop-up, bought-together, checkout or thank-you page — wherever a shopper is already paying attention.</p></div>
        <div class="step rv"><div class="sn">02</div><h3>Choose what it learns from</h3><p>Bought together, added together, viewed together, similar, your goes-with rules, best sellers, trending — or a list of your own. Add conditions so it only shows when it fits.</p></div>
        <div class="step rv"><div class="sn">03</div><h3>Publish, then test it</h3><p>Go live on the rule you set. On Growth, switch on Intent suggest and run the on/off test to read what it earned — on the same shoppers, in your own dashboard.</p></div>
      </div>
    </div>
  </section>

  <!-- ===================== FEATURE DETAIL =====================
       Five sections, each a claim + its own illustration, alternating sides
       (components/UpsellFeatures.astro) — same shape as the Merchandising
       page's detail section. -->
  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <UpsellFeatures />
    </div>
  </section>

  <!-- ===================== CTA ===================== -->
  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="cta rv">
        <h2>Ready to see it in <em>action?</em></h2>
        <p>Install free, add one block, and read what it earned in your own dashboard.</p>
        <div class="hero-cta" style="justify-content:center">
          <a href={APP_STORE_URL} class="btn btn-accent btn-lg">Get started <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          <BookDemo class="btn btn-ghost btn-lg">Book a demo</BookDemo>
        </div>
      </div>
    </div>
  </section>
</Base>
