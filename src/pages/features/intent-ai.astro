---
/**
 * /features/intent-ai — the whole of Intent AI on one page.
 *
 * The rule for this page is the home page's rule, held harder: every sentence
 * must be something a merchant can find and check inside the app. Intent AI is
 * the part of the product most easily oversold ("AI that reads minds"), so the
 * page's job is the opposite — say exactly what it reads, where it acts, what
 * is still in testing, and how a merchant proves it for themselves.
 *
 * Two words carry status everywhere on the page (the mind map's legend):
 *   Live    — runs on stores whose plan has it, where the merchant switched it on
 *   Testing — computed and shown to the merchant, NOT used to rank a storefront
 * Anything learned (the per-intent picks, the trained model) is Testing. Do not
 * move a line to Live until the app serves it by default.
 *
 * Copy sources, so a change in the app can be followed here:
 *   the five intents' names and descriptions — qsortby
 *     apps/shopify/app/utils/intent-state-display.ts (INTENT_META)
 *   "Intent suggest" — the switch on the collection editor and on the cart,
 *     popup, checkout and thank-you upsell editors
 *   "Mix up the first ten for 1 in 20 views" — the collection editor's
 *     Personalize settings card
 */
import Base from '../../layouts/Base.astro';
import { APP_STORE_URL, GUIDE_URL } from '../../consts';
import { REVERSE_TRIAL_DAYS } from '../../plans';
import BookDemo from '../../components/BookDemo.astro';
import IntentHero from '../../components/IntentHero.astro';
import IntentMindMap from '../../components/IntentMindMap.astro';
import type { Branch } from '../../components/IntentMindMap.astro';

const title = 'Intent AI — QSortby';
const description =
  'Intent AI reads why each visitor came — from this visit alone — and lets your For You feed and upsells rank by it, as one signal in a formula you can read. Then it shows you what it read, and a split test tells you whether it paid.';

/* The five intents, in the app's own words (INTENT_META). `sells` is the
   app's hint for each, trimmed. */
const MODES = [
  {
    key: 'treat',
    label: 'Treating themselves',
    reads: 'Browsing unhurried and lingering on the dearer items — no deadline, nothing particular in mind.',
    sells: 'Premium bundles and the nicer size.',
  },
  {
    key: 'need',
    label: 'Replacing something',
    reads: 'Arrived knowing what they want and moving fast — an urgent search, quick scrolling, the cheaper end.',
    sells: 'The obvious choice, easy to find.',
  },
  {
    key: 'gift',
    label: 'Buying a gift',
    reads: 'Shopping for someone else — gift words in the search, or ranging across unrelated categories and prices.',
    sells: 'Gift sets, wrapping and delivery dates.',
  },
  {
    key: 'browse',
    label: 'Browsing',
    reads: 'Looking around with nothing picked out — many pages across many categories, nothing in the cart.',
    sells: 'Range and new arrivals.',
  },
  {
    key: 'close',
    label: 'Close to buying',
    reads: 'Came straight here and acts decisively — few pages, something already in the cart, nothing taken back out.',
    sells: 'Stock, shipping and returns.',
  },
];

const BRANCHES: Branch[] = [
  {
    key: 'read', n: '01', title: 'Read', slot: 'tl',
    sub: 'From this visit’s own behaviour. No login, no purchase history, no quiz.',
    leaves: [
      { text: '<b>Five reasons</b> people shop — treating themselves, replacing something, buying a gift, browsing, close to buying', status: 'live' },
      { text: '<b>One visit at a time</b> — 30 minutes with nothing happening ends a visit', status: 'live' },
      { text: '<b>Commits only on clear evidence</b> — until then the visit sees your normal order', status: 'live' },
      { text: '<b>Every product tagged</b> with one or two of the five, by AI — and you can change any tag', status: 'live' },
    ],
  },
  {
    key: 'act', n: '02', title: 'Act', slot: 'bl',
    sub: 'Only where you switch Intent suggest on.',
    leaves: [
      { text: '<b>For You</b> feeds, on each personalized collection you switch it on for', status: 'live' },
      { text: '<b>Cart, popup, checkout and thank-you</b> upsells, when they pick their own suggestions', status: 'live' },
      { text: '<b>One weighted signal</b> in a formula you can read, with its share of the score shown', status: 'live' },
      { text: '<b>Tagged products move ahead</b>; nothing is pushed down, and an untagged catalogue never moves', status: 'live' },
    ],
  },
  {
    key: 'learn', n: '03', title: 'Learn', slot: 'tr',
    sub: 'Everything learned is held in testing and compared against what you already have.',
    leaves: [
      { text: '<b>Learned picks</b> — per intent, the products those shoppers actually buy on your store', status: 'testing' },
      { text: '<b>A strict bar</b> — beat your best sellers on visits it did not learn from, three nights running', status: 'testing' },
      { text: '<b>Trained model</b> — checked against the tag match on visits it never saw', status: 'testing' },
      { text: '<b>Mix up the first ten</b> on 1 in 20 For You views, so it learns what shoppers wanted rather than what was put first', status: 'live' },
    ],
  },
  {
    key: 'prove', n: '04', title: 'Prove', slot: 'br',
    sub: 'Every figure comes from your own store, and says what it is.',
    leaves: [
      { text: '<b>The Intent tab</b> — visits by the reason each ended on, hour by hour in your store’s time', status: 'live' },
      { text: '<b>Readings checked against orders</b> — gifts shipped to someone else, repeat buys, a pick from an earlier visit', status: 'live' },
      { text: '<b>Intent AI on/off test</b> — a share of shoppers without it, read once at a planned end', status: 'live' },
      { text: '<b>Influenced, never “caused”</b> — revenue is labelled for what it is', status: 'live' },
    ],
  },
  {
    key: 'guard', n: '05', title: 'Guardrails', slot: 'bottom',
    sub: 'So nothing happens on your storefront that you cannot see, explain or switch off.',
    leaves: [
      { text: '<b>A switch wherever it acts</b> — per collection and per upsell', status: 'live' },
      { text: '<b>Read-only first</b> — on Pro it reports; only Growth lets it rank', status: 'live' },
      { text: '<b>Fails open</b> — if the AI is unavailable, your storefront ranks by your own rules', status: 'live' },
      { text: '<b>AI summaries are checked</b> before you see them — every number must be one your data holds', status: 'live' },
      { text: '<b>Shoppers never see a label</b> — a reading changes an order, never a word on the page', status: 'live' },
      { text: '<b>A declined consent is respected</b> — the pixel then sends only that a visit started, and that visit is never read', status: 'live' },
    ],
  },
];

const FAQ = [
  {
    q: 'Does Intent AI need a login or purchase history?',
    a: 'No. It reads only what this visit does — what was searched, how many pages and categories, which prices were looked at, what went into the cart and came back out. A first-time visitor is read the same way as anyone else.',
  },
  {
    q: 'Will it change my storefront without me knowing?',
    a: 'No. It ranks only where you switch <b>Intent suggest</b> on — per collection, and per upsell. Everywhere else it only reports. On the Pro plan it never ranks at all; it shows you the mix of visits your store gets.',
  },
  {
    q: 'What does it actually change?',
    a: 'Where it is on, products tagged with the visit’s intent move ahead of the others. Intent is one weighted signal in your ranking formula, so every other signal keeps its weight — and the collection editor shows what share of the score intent carries. Products need intent tags for it to change anything.',
  },
  {
    q: 'Is this an AI that reads emotions?',
    a: 'No. It reads five practical reasons to shop, from behaviour, with fixed rules rather than a model guessing — the app describes what each reason looks like. AI tags your products, writes the summaries in the Intent tab, and, in testing, learns which products each reason’s shoppers buy.',
  },
  {
    q: 'What happens when it cannot tell why someone came?',
    a: 'They see your normal order. Intent AI commits to a reading only when the visit gives it clear evidence; a visit it has not read is ranked exactly as it would be without Intent AI.',
  },
  {
    q: 'How do I know it is making money?',
    a: 'Run the <b>Intent AI on/off test</b>. A share of your shoppers get the same store without Intent AI, and the test compares how many shoppers in each group bought anything, anywhere on the store. It runs for a planned number of weeks and is read once at the end, so an early lucky streak cannot decide it.',
  },
  {
    q: 'Is the machine-learning part ranking my store?',
    a: 'No. What Intent AI learns — which products each intent’s shoppers buy, and a trained model — is shown to you in the Intent tab as in testing, measured against what you already have on visits it did not learn from, and kept off your storefront. Today your storefront is ranked by your formula and your product tags.',
  },
];
---
<Base title={title} description={description} breadcrumb="Intent AI" faq={FAQ}>
  <section class="phero phero-mint">
    <div class="wrap herogrid">
      <div>
        <div class="crumb">Intent AI</div>
        <h1>Knows why they came. Shows you what it did about it.</h1>
        <p>Intent AI reads one visit — no login, no purchase history — and, once the visit makes it clear, settles on one of five reasons people shop. Your For You feed and upsells can rank by it, as one signal in a formula you can read. The Intent tab shows what it read, and a split test tells you whether it paid.</p>
        <div class="hero-cta" style="margin-top:2rem">
          <a href={APP_STORE_URL} class="btn btn-accent btn-lg">Try it free <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          <a href="#map" class="btn btn-ghost btn-lg">See the whole system</a>
        </div>
      </div>
      <IntentHero
        steps={[
          'Searched “birthday gift for her”',
          'Looked across four unrelated categories',
          'Looked at prices from $18 to $140',
        ]}
        reading="Buying a gift"
        tagLabel="Gift tag"
        products={[
          { name: 'Rose Gift Set', price: '$64', img: '/products/perfume-rose.svg', tag: true },
          { name: 'Amber Candle Duo', price: '$38', img: '/products/candle-amber.svg', tag: true },
          { name: 'Reed Diffuser', price: '$42', img: '/products/diffuser-reed.svg' },
          { name: 'Wax Melts', price: '$14', img: '/products/wax-melts.svg' },
        ]}
      />
    </div>
  </section>

  <!-- ===================== THE FIVE INTENTS ===================== -->
  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="shead ctr rv" style="margin-bottom:2.5rem">
        <span class="eyebrow"><span class="dot"></span>Five reasons people shop</span>
        <h2>One reading per visit. Five you can act on.</h2>
        <p class="lead-c">Not twelve moods and not a personality score — five reasons a merchant can merchandise for, each described in the app exactly as it is read.</p>
      </div>
      <div class="ia-modes">
        {MODES.map((m, i) => (
          <article class={`ia-mode rv ia-mode-${m.key}`}>
            <span class="ia-mode-n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{m.label}</h3>
            <p>{m.reads}</p>
            <div class="ia-mode-sells"><span>What tends to work</span>{m.sells}</div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== THE MIND MAP ===================== -->
  <section class="sec ia-mapsec" id="map">
    <div class="wrap">
      <div class="shead ctr rv" style="margin-bottom:3rem">
        <span class="eyebrow"><span class="dot"></span>The whole system</span>
        <h2>Every part of Intent AI, on one page.</h2>
        <p class="lead-c">What it reads, where it acts, how it learns, how you prove it, and what keeps it in line — each marked with whether it ranks your storefront today.</p>
      </div>
      <div class="rv">
        <IntentMindMap branches={BRANCHES} />
      </div>
    </div>
  </section>

  <!-- ===================== HOW A VISIT IS READ ===================== -->
  <section class="sec">
    <div class="wrap">
      <div class="shead ctr rv" style="margin-bottom:2.5rem">
        <h2>From a visit to a ranking</h2>
      </div>
      <div class="steps ia-steps4">
        <div class="step rv"><div class="sn">01</div><h3>Watch this visit</h3><p>The storefront pixel sees what the visit does — the search, the pages, the prices, the cart. A visit ends after 30 minutes with nothing happening.</p></div>
        <div class="step rv"><div class="sn">02</div><h3>Commit to one reason</h3><p>Each of the five is scored as the visit goes on. Intent AI commits only when one is clear; until then the shopper sees your normal order.</p></div>
        <div class="step rv"><div class="sn">03</div><h3>Rank where you allowed it</h3><p>Where Intent suggest is on, products tagged with that reason move ahead of the rest. Nothing is pushed down.</p></div>
        <div class="step rv"><div class="sn">04</div><h3>Report it</h3><p>The Intent tab counts every visit under the reason it ended on, so you see your store’s real mix — and what each kind of visit bought.</p></div>
      </div>
    </div>
  </section>

  <!-- ===================== DETAIL ===================== -->
  <section class="sec" style="padding-top:0">
    <div class="wrap split-list">

      <!-- A — one signal, in a formula you can read -->
      <div class="split rv">
        <div>
          <span class="eyebrow"><span class="dot"></span>Glass box</span>
          <h2>One signal in your formula — never a black box over it</h2>
          <p class="lead">Intent match is one weighted signal beside your top sellers, recent views, new arrivals and the rest. The collection editor shows the share of the score it carries in each group of shoppers, and every product in the preview shows why it sits where it does.</p>
          <ul class="ia-checks">
            <li><svg viewBox="0 0 24 24"><path d="M5 12l5 5L20 7"/></svg>Every other signal in your formula keeps its weight</li>
            <li><svg viewBox="0 0 24 24"><path d="M5 12l5 5L20 7"/></svg>Intent’s share of each group’s score, stated in plain numbers</li>
            <li><svg viewBox="0 0 24 24"><path d="M5 12l5 5L20 7"/></svg>A shopper with no reading sees the order your formula gives</li>
          </ul>
        </div>
        <div class="ia-viz">
          <div class="ia-panel">
            <span class="ia-panel-k">Why this product · Rose Gift Set</span>
            {[
              { s: 'Top seller', w: 44 },
              { s: 'Intent match', w: 23, on: true },
              { s: 'Recently viewed', w: 19 },
              { s: 'New arrival', w: 14 },
            ].map((r) => (
              <div class={`ia-bar${r.on ? ' on' : ''}`}>
                <span class="ia-bar-l">{r.s}</span>
                <span class="ia-bar-t"><i style={`width:${r.w}%`}></i></span>
                <span class="ia-bar-v">{r.w}%</span>
              </div>
            ))}
            <p class="ia-panel-cap">Illustration · each signal’s share of this product’s score</p>
          </div>
        </div>
      </div>

      <!-- B — where it acts -->
      <div class="split split-rev rv">
        <div>
          <span class="eyebrow"><span class="dot"></span>Where it acts</span>
          <h2>The feed and the four upsells that can use it</h2>
          <p class="lead">Intent suggest is a switch on each personalized collection, and on the cart, popup, checkout and thank-you upsells when they pick their own suggestions. Bought-together and the free-shipping bar choose on their own evidence — co-purchase pairs and price — and are never re-ranked by intent.</p>
        </div>
        <div class="ia-viz">
          <div class="ia-panel">
            <span class="ia-panel-k">Intent suggest</span>
            {[
              { p: 'For You feed', d: 'Per personalized collection', on: true },
              { p: 'Cart upsell', d: 'Per offer, auto suggestions', on: true },
              { p: 'Popup', d: 'Per offer, auto suggestions', on: true },
              { p: 'In-checkout', d: 'Per offer · Shopify Plus', on: true },
              { p: 'Thank-you page', d: 'Per offer, auto suggestions', on: true },
              { p: 'Bought together', d: 'Co-purchase pairs', on: false },
              { p: 'Free-shipping bar', d: 'Price band', on: false },
            ].map((r) => (
              <div class={`ia-place${r.on ? '' : ' off'}`}>
                <span class="ia-place-p">{r.p}<small>{r.d}</small></span>
                <span class="ia-place-s">{r.on ? 'Can use intent' : 'Not intent'}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- C — tags you can edit -->
      <div class="split rv">
        <div>
          <span class="eyebrow"><span class="dot"></span>Product tags</span>
          <h2>AI tags your catalogue. You have the last word.</h2>
          <p class="lead">Each product is tagged with one or two of the five reasons, read from its own product text. Settings → Product data &amp; AI lists every tag. Change one and it is marked <b>Set by you</b> and kept when the product next changes — only re-running the AI over the whole catalogue by hand replaces it, and <b>Use AI’s pick</b> puts the AI’s choice back.</p>
        </div>
        <div class="ia-viz">
          <div class="ia-panel">
            <span class="ia-panel-k">Product data &amp; AI · intent tags</span>
            {[
              { p: 'Rose Gift Set', t: 'Buying a gift', by: 'AI' },
              { p: 'Refill Pack, 500ml', t: 'Replacing something', by: 'AI' },
              { p: 'Oud Attar', t: 'Treating themselves', by: 'Set by you' },
              { p: 'Mini Discovery Set', t: 'Browsing', by: 'AI' },
            ].map((r) => (
              <div class="ia-tagrow">
                <span class="ia-tagrow-p">{r.p}</span>
                <span class="ia-tagrow-t">{r.t}</span>
                <span class={`ia-tagrow-by${r.by === 'AI' ? '' : ' you'}`}>{r.by}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== PROOF ===================== -->
  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="shead ctr rv" style="margin-bottom:2.5rem">
        <span class="eyebrow"><span class="dot"></span>Proof, not promises</span>
        <h2>Five ways to check it on your own store</h2>
        <p class="lead-c">Personalization apps ask you to trust a lift figure. Intent AI gives you the readings, the orders they line up with, and a test you control.</p>
      </div>
      <div class="bento">
        <div class="b rv">
          <span class="kicker">The Intent tab</span>
          <h3>What your visits came for</h3>
          <p>Every visit counted under the reason it ended on, hour by hour in your store’s own time zone, with what each kind of visit bought. AI summaries quote only numbers your data holds, and never call something a trend without a fair comparison.</p>
        </div>
        <div class="b rv">
          <span class="kicker">Checked against orders</span>
          <h3>Did the orders agree?</h3>
          <p>Some orders can confirm a reading: a gift shipped to someone else, a repeat buy of the same thing, a product picked out on an earlier visit. The Intent tab shows how often those orders agree with what was read — and says when there are too few to tell.</p>
        </div>
        <div class="b rv">
          <span class="kicker">Tags vs purchases</span>
          <h3>Do the tags match what sells?</h3>
          <p>For each reason, whether those shoppers buy its tagged products more often than everyone else does — labelled as a pattern, not as proof that intent caused it.</p>
        </div>
        <div class="b wide rv ia-test">
          <div>
          <span class="kicker">Intent AI on/off test</span>
          <h3>The one number that settles it</h3>
          <p>A share of shoppers get your store without Intent AI — in the For You feed and in every upsell that ranks by it. The test compares the share of shoppers in each group who bought anything, anywhere on the store, not clicks on one widget. It runs for a planned number of whole weeks, gives no verdict until the end, stops early only if Intent AI is clearly doing harm, and checks the split itself is fair first. “No difference” always says how big a difference the test could have found.</p>
          </div>
          <ol class="ia-test-flow" aria-label="How the test runs">
            <li><span>Split</span>Each shopper lands in one group, and stays there</li>
            <li><span>Measure</span>The share who bought anything, anywhere on the store</li>
            <li><span>Check</span>Is the split itself fair? If not, no verdict</li>
            <li><span>Read</span>Once, at the planned end — 2 to 6 whole weeks</li>
          </ol>
        </div>
        <div class="b rv">
          <span class="kicker">Attribution</span>
          <h3>Influenced, never caused</h3>
          <p>An order is credited to the place a shopper last touched before buying — an upsell only for the lines it added — and labelled “influenced”, because that is all last touch can say.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== LEARNING ===================== -->
  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="band rv ia-learn">
        <div class="ia-learn-h">
          <span class="eyebrow"><span class="dot"></span>How it learns</span>
          <h2>Learning that has to beat what you already have</h2>
          <p>Intent AI keeps learning from your store. Nothing it learns ranks a storefront on the strength of looking good — it is held in testing, shown to you, and measured against the plain alternative on visits it did not learn from.</p>
        </div>
        <ol class="ia-learn-list">
          <li>
            <span class="ia-st ia-st-testing">Testing</span>
            <h3>Learned picks, per intent</h3>
            <p>Each night, for each reason, the products those shoppers actually bought after viewing them — compared with your top best sellers on recent buying visits it did not learn from. It needs at least 30 buying visits, four weeks of data and a clear win, three nights in a row — and the Intent tab shows it as <b>Ready</b>, not as ranking.</p>
          </li>
          <li>
            <span class="ia-st ia-st-testing">Testing</span>
            <h3>A trained model</h3>
            <p>Trained on past visits and checked against the tag match on visits it never saw. The Intent tab says how it did, in plain words, and that it is still in testing.</p>
          </li>
          <li>
            <span class="ia-st ia-st-live">Live</span>
            <h3>Mix up the first ten</h3>
            <p>On 1 in 20 For You views the first ten products appear in a random order — the same products, sold-out ones left in place — so clicks say what shoppers wanted, not what was put first. One tickbox per collection turns it off.</p>
          </li>
          <li>
            <span class="ia-st ia-st-live">Live</span>
            <h3>No marking its own homework</h3>
            <p>Visits known to have been ranked by intent are left out of what it learns from, so it cannot simply learn to repeat its own order.</p>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- ===================== PLANS ===================== -->
  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="shead ctr rv" style="margin-bottom:2.5rem">
        <h2>Look first, then let it rank</h2>
      </div>
      <div class="ia-plans">
        <div class="ia-plan rv">
          <span class="kicker">Pro · $99</span>
          <h3>Read-only</h3>
          <p>See the mix of visits your store gets. Your storefront is never touched.</p>
        </div>
        <div class="ia-plan feat rv">
          <span class="kicker">Growth · $199</span>
          <h3>Live</h3>
          <p>Intent suggest on your For You collections and the cart, popup, checkout and thank-you upsells, the full Intent tab with AI summaries, and the on/off test.</p>
        </div>
        <div class="ia-plan rv">
          <span class="kicker">Every new install</span>
          <h3>{REVERSE_TRIAL_DAYS} days of Growth</h3>
          <p>Free, with no card. Then the store moves to Free on its own — never locked.</p>
        </div>
      </div>
      <p class="ia-plans-more rv"><a href="/pricing">Compare every plan →</a></p>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <section class="sec" style="padding-top:0">
    <div class="narrow">
      <div class="shead ctr rv" style="margin-bottom:2rem">
        <h2>Questions merchants ask</h2>
      </div>
      <div class="faq ia-faq rv">
        {FAQ.map((f, i) => (
          <details open={i === 0}><summary>{f.q}<span class="pm"></span></summary><div class="ans" set:html={f.a} /></details>
        ))}
      </div>
      <p class="ia-plans-more rv">The <a href={GUIDE_URL}>user guide</a> walks through every setting in the app.</p>
    </div>
  </section>

  <!-- ===================== CTA ===================== -->
  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="cta rv">
        <h2>See what your visits <em>came for.</em></h2>
        <p>Install free, look at the Intent tab, and switch it on only where you want it.</p>
        <div class="hero-cta" style="justify-content:center">
          <a href={APP_STORE_URL} class="btn btn-accent btn-lg">Get started <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          <BookDemo class="btn btn-ghost btn-lg">Book a demo</BookDemo>
        </div>
      </div>
    </div>
  </section>
</Base>

<style is:global>
  /* the five intents */
  .ia-modes { display:grid; grid-template-columns:1fr; gap:12px; }
  @media (min-width:640px){ .ia-modes { grid-template-columns:1fr 1fr; } }
