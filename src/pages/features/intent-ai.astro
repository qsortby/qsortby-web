---
/**
 * /features/intent-ai — the whole of Intent AI on one page.
 *
 * The rule for this page is the home page's rule, held harder: every sentence
 * must be something a merchant can find and check inside the app. Intent AI is
 * the part of the product most easily oversold ("AI that reads minds"), so the
 * page's job is the opposite — say exactly what it reads, where it acts, what
 * is still in testing, and how a merchant proves it for themselves.
 *
 * Pictures first, words second: every section is a diagram with a heading and
 * at most a line or two under it. The detail a merchant needs to check a claim
 * is in the app; the page only has to make the shape of the system obvious.
 *
 * Two words carry status everywhere on the page (the mind map's legend):
 *   Live    — runs on stores whose plan has it, where the merchant switched it on
 *   Testing — computed and shown to the merchant, NOT used to rank a storefront
 * Anything learned (the per-intent picks, the trained model) is Testing. Do not
 * move a line to Live until the app serves it by default.
 *
 * Copy sources, so a change in the app can be followed here:
 *   the five intents' names and descriptions — qsortby
 *     apps/shopify/app/utils/intent-state-display.ts (INTENT_META)
 *   "Intent suggest" — the switch on the collection editor and on the cart,
 *     popup, checkout and thank-you upsell editors
 *   "Mix up the first ten for 1 in 20 views" — the collection editor's
 *     Personalize settings card
 */
import Base from '../../layouts/Base.astro';
import { APP_STORE_URL, GUIDE_URL } from '../../consts';
import { REVERSE_TRIAL_DAYS } from '../../plans';
import BookDemo from '../../components/BookDemo.astro';
import IntentHero from '../../components/IntentHero.astro';
import IntentMindMap from '../../components/IntentMindMap.astro';
import IntentFlow from '../../components/IntentFlow.astro';
import IntentProof from '../../components/IntentProof.astro';
import IntentLearn from '../../components/IntentLearn.astro';
import type { Branch } from '../../components/IntentMindMap.astro';

const title = 'Intent AI — QSortby';
const description =
  'Intent AI reads why each visitor came — from this visit alone — and lets your For You feed and upsells rank by it, as one signal in a formula you can read. Then it shows you what it read, and a split test tells you whether it paid.';

/* The five intents, in the app's own words (INTENT_META), cut to a cue.
   "Close to buying" deliberately omits the app blurb's "has been before": the
   pixel never sends the repeat-visitor input, so that rule never fires. */
const MODES = [
  { key: 'treat', label: 'Treating themselves', cue: 'Unhurried, on the dearer items', works: 'Premium bundles',
    icon: '<path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/><path d="M18.5 15.5l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7z"/>' },
  { key: 'need', label: 'Replacing something', cue: 'Knows what they want, moves fast', works: 'The obvious choice',
    icon: '<path d="M19.5 11A7.5 7.5 0 0 0 5.7 7"/><path d="M5 3.5V7.5h4"/><path d="M4.5 13a7.5 7.5 0 0 0 13.8 4"/><path d="M19 20.5v-4h-4"/>' },
  { key: 'gift', label: 'Buying a gift', cue: 'Gift words, many categories', works: 'Gift sets, delivery dates',
    icon: '<rect x="3" y="8" width="18" height="13" rx="2"/><path d="M12 8v13M3 12.5h18"/><path d="M12 8c-1.5-3.2-5.5-3.2-5.5-.6C6.5 8 8 8 12 8zm0 0c1.5-3.2 5.5-3.2 5.5-.6C17.5 8 16 8 12 8z"/>' },
  { key: 'browse', label: 'Browsing', cue: 'Many pages, empty cart', works: 'Range, new arrivals',
    icon: '<circle cx="12" cy="12" r="8.5"/><path d="M15.5 8.5l-2.1 4.9-4.9 2.1 2.1-4.9z"/>' },
  { key: 'close', label: 'Close to buying', cue: 'Few pages, something in the cart', works: 'Stock, shipping, returns',
    icon: '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4.8"/><circle cx="12" cy="12" r="1.3"/>' },
];

const BRANCHES: Branch[] = [
  {
    key: 'read', n: '01', title: 'Read', slot: 'tl',
    sub: 'This visit only — no login, no history.',
    leaves: [
      { text: '<b>Five reasons</b> people shop', status: 'live' },
      { text: '<b>A visit</b> ends after 30 quiet minutes', status: 'live' },
      { text: '<b>Commits</b> only on a clear lead', status: 'live' },
      { text: '<b>Product tags</b> by AI — you can edit them', status: 'live' },
    ],
  },
  {
    key: 'act', n: '02', title: 'Act', slot: 'bl',
    sub: 'Only where Intent suggest is on.',
    leaves: [
      { text: '<b>For You</b> feeds', status: 'live' },
      { text: '<b>Cart, popup, checkout, thank-you</b> upsells', status: 'live' },
      { text: '<b>One weighted signal</b>, share shown', status: 'live' },
      { text: '<b>Tagged products</b> move ahead', status: 'live' },
    ],
  },
  {
    key: 'learn', n: '03', title: 'Learn', slot: 'tr',
    sub: 'Held in testing until it beats what you have.',
    leaves: [
      { text: '<b>Learned picks</b> per intent', status: 'testing' },
      { text: '<b>Must beat</b> your best sellers', status: 'testing' },
      { text: '<b>Trained model</b>, checked against tags', status: 'testing' },
      { text: '<b>Mix up the first ten</b>, 1 in 20 views', status: 'live' },
    ],
  },
  {
    key: 'prove', n: '04', title: 'Prove', slot: 'br',
    sub: 'Every figure from your own store.',
    leaves: [
      { text: '<b>Intent tab</b>, in your time zone', status: 'live' },
      { text: '<b>Readings</b> checked against orders', status: 'live' },
      { text: '<b>On/off test</b>, read at a planned end', status: 'live' },
      { text: '<b>Influenced</b>, never “caused”', status: 'live' },
    ],
  },
  {
    key: 'guard', n: '05', title: 'Guardrails', slot: 'bottom',
    sub: 'Nothing on your storefront you cannot see or switch off.',
    leaves: [
      { text: '<b>A switch</b> per collection and upsell', status: 'live' },
      { text: '<b>Pro reports</b> · Growth ranks', status: 'live' },
      { text: '<b>Fails open</b> to your own rules', status: 'live' },
      { text: '<b>AI summaries</b> checked against your data', status: 'live' },
      { text: '<b>Shoppers</b> never see a label', status: 'live' },
      { text: '<b>Declined consent</b> — visit never read', status: 'live' },
    ],
  },
];

const FAQ = [
  {
    q: 'Does Intent AI need a login or purchase history?',
    a: 'No. It reads only what this visit does — what was searched, how many pages and categories, which prices were looked at, what went into the cart and came back out. A first-time visitor is read the same way as anyone else.',
  },
  {
    q: 'Will it change my storefront without me knowing?',
    a: 'No. It ranks only where you switch <b>Intent suggest</b> on — per collection, and per upsell. Everywhere else it only reports. On the Pro plan it never ranks at all; it shows you the mix of visits your store gets.',
  },
  {
    q: 'What does it actually change?',
    a: 'Where it is on, products tagged with the visit’s intent move ahead of the others. Intent is one weighted signal in your ranking formula, so every other signal keeps its weight — and the collection editor shows what share of the score intent carries. Products need intent tags for it to change anything.',
  },
  {
    q: 'Is this an AI that reads emotions?',
    a: 'No. It reads five practical reasons to shop, from behaviour, with fixed rules rather than a model guessing — the app describes what each reason looks like. AI tags your products, writes the summaries in the Intent tab, and, in testing, learns which products each reason’s shoppers buy.',
  },
  {
    q: 'What happens when it cannot tell why someone came?',
    a: 'They see your normal order. Intent AI commits to a reading only when the visit gives it clear evidence; a visit it has not read is ranked exactly as it would be without Intent AI.',
  },
  {
    q: 'How do I know it is making money?',
    a: 'Run the <b>Intent AI on/off test</b>. A share of your shoppers get the same store without Intent AI, and the test compares how many shoppers in each group bought anything, anywhere on the store. It runs for a planned number of weeks and is read once at the end, so an early lucky streak cannot decide it.',
  },
  {
    q: 'Is the machine-learning part ranking my store?',
    a: 'No. What Intent AI learns — which products each intent’s shoppers buy, and a trained model — is shown to you in the Intent tab as in testing, measured against what you already have on visits it did not learn from, and kept off your storefront. Today your storefront is ranked by your formula and your product tags.',
  },
];
---
<Base title={title} description={description} breadcrumb="Intent AI" faq={FAQ}>
  <section class="phero phero-mint">
    <div class="wrap herogrid">
      <div>
        <div class="crumb">Intent AI</div>
        <h1>Knows why they came. Shows you what it did about it.</h1>
        <p>One reading per visit, five reasons people shop. Your feed and upsells can rank by it — and you can check every step.</p>
        <div class="hero-cta" style="margin-top:2rem">
          <a href={APP_STORE_URL} class="btn btn-accent btn-lg">Try it free <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          <a href="#map" class="btn btn-ghost btn-lg">See the whole system</a>
        </div>
      </div>
      <IntentHero
        steps={[
          'Searched “birthday gift for her”',
          'Looked across four unrelated categories',
          'Looked at prices from $18 to $140',
        ]}
        reading="Buying a gift"
        tagLabel="Gift tag"
        products={[
          { name: 'Rose Gift Set', price: '$64', img: '/products/perfume-rose.svg', tag: true },
          { name: 'Amber Candle Duo', price: '$38', img: '/products/candle-amber.svg', tag: true },
          { name: 'Reed Diffuser', price: '$42', img: '/products/diffuser-reed.svg' },
          { name: 'Wax Melts', price: '$14', img: '/products/wax-melts.svg' },
        ]}
      />
    </div>
  </section>

  <!-- ===================== THE FIVE INTENTS ===================== -->
  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="shead ctr rv" style="margin-bottom:2.25rem">
        <span class="eyebrow"><span class="dot"></span>Five reasons people shop</span>
        <h2>Five readings you can merchandise for.</h2>
      </div>
      <div class="ia-modes">
        {MODES.map((m) => (
          <article class="ia-mode rv">
            <span class="ia-ic"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={m.icon} /></span>
            <h3>{m.label}</h3>
            <p>{m.cue}</p>
            <span class="ia-works">{m.works}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== FROM A VISIT TO A RANKING ===================== -->
  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="shead ctr rv" style="margin-bottom:2.25rem">
        <span class="eyebrow"><span class="dot"></span>How it works</span>
        <h2>From a visit to a ranking</h2>
      </div>
      <div class="rv"><IntentFlow /></div>
    </div>
  </section>

  <!-- ===================== THE MIND MAP ===================== -->
  <section class="sec ia-mapsec" id="map">
    <div class="wrap">
      <div class="shead ctr rv" style="margin-bottom:3rem">
        <span class="eyebrow"><span class="dot"></span>The whole system</span>
        <h2>Every part of Intent AI, on one page.</h2>
      </div>
      <div class="rv">
        <IntentMindMap branches={BRANCHES} />
      </div>
    </div>
  </section>

  <!-- ===================== DETAIL ===================== -->
  <section class="sec">
    <div class="wrap split-list">

      <!-- A — one signal, in a formula you can read -->
      <div class="split rv">
        <div>
          <span class="eyebrow"><span class="dot"></span>Glass box</span>
          <h2>One signal in your formula — never a black box</h2>
          <p class="lead">You see the share of the score intent carries, and why each product sits where it does.</p>
        </div>
        <div class="ia-viz">
          <div class="ia-panel">
            <span class="ia-panel-k">Why this product · Rose Gift Set</span>
            {[
              { s: 'Top seller', w: 44 },
              { s: 'Intent match', w: 23, on: true },
              { s: 'Recently viewed', w: 19 },
              { s: 'New arrival', w: 14 },
            ].map((r) => (
              <div class={`ia-bar${r.on ? ' on' : ''}`}>
                <span class="ia-bar-l">{r.s}</span>
                <span class="ia-bar-t"><i style={`width:${r.w}%`}></i></span>
                <span class="ia-bar-v">{r.w}%</span>
              </div>
            ))}
            <p class="ia-panel-cap">Illustration · each signal’s share of the score</p>
          </div>
        </div>
      </div>

      <!-- B — where it acts -->
      <div class="split split-rev rv">
        <div>
          <span class="eyebrow"><span class="dot"></span>Where it acts</span>
          <h2>The feed, and four upsells</h2>
          <p class="lead">One switch — Intent suggest — on each. Bought-together and the shipping bar never use intent.</p>
        </div>
        <div class="ia-viz">
          <div class="ia-panel">
            <span class="ia-panel-k">Intent suggest</span>
            {[
              { p: 'For You feed', d: 'Per personalized collection', on: true },
              { p: 'Cart upsell', d: 'Per offer, auto suggestions', on: true },
              { p: 'Popup', d: 'Per offer, auto suggestions', on: true },
              { p: 'In-checkout', d: 'Per offer · Shopify Plus', on: true },
              { p: 'Thank-you page', d: 'Per offer, auto suggestions', on: true },
              { p: 'Bought together', d: 'Co-purchase pairs', on: false },
              { p: 'Free-shipping bar', d: 'Price band', on: false },
            ].map((r) => (
              <div class={`ia-place${r.on ? '' : ' off'}`}>
                <span class="ia-place-p">{r.p}<small>{r.d}</small></span>
                <span class="ia-place-s">{r.on ? 'Can use intent' : 'Not intent'}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- C — tags you can edit -->
      <div class="split rv">
        <div>
          <span class="eyebrow"><span class="dot"></span>Product tags</span>
          <h2>AI tags your catalogue. You have the last word.</h2>
          <p class="lead">Change a tag and it is marked <b>Set by you</b> and kept. <b>Use AI’s pick</b> puts it back.</p>
        </div>
        <div class="ia-viz">
          <div class="ia-panel">
            <span class="ia-panel-k">Product data &amp; AI · intent tags</span>
            {[
              { p: 'Rose Gift Set', t: 'Buying a gift', by: 'AI' },
              { p: 'Refill Pack, 500ml', t: 'Replacing something', by: 'AI' },
              { p: 'Oud Attar', t: 'Treating themselves', by: 'Set by you' },
              { p: 'Mini Discovery Set', t: 'Browsing', by: 'AI' },
            ].map((r) => (
              <div class="ia-tagrow">
                <span class="ia-tagrow-p">{r.p}</span>
                <span class="ia-tagrow-t">{r.t}</span>
                <span class={`ia-tagrow-by${r.by === 'AI' ? '' : ' you'}`}>{r.by}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== PROOF ===================== -->
  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="shead ctr rv" style="margin-bottom:2.25rem">
        <span class="eyebrow"><span class="dot"></span>Proof, not promises</span>
        <h2>Check it on your own store</h2>
      </div>
      <IntentProof />
    </div>
  </section>

  <!-- ===================== LEARNING ===================== -->
  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="band rv">
        <div class="shead ctr" style="margin-bottom:2rem">
          <span class="eyebrow"><span class="dot"></span>How it learns</span>
          <h2>Learning that has to beat what you already have</h2>
        </div>
        <IntentLearn />
      </div>
    </div>
  </section>

  <!-- ===================== PLANS ===================== -->
  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="shead ctr rv" style="margin-bottom:2.25rem">
        <h2>Look first, then let it rank</h2>
      </div>
      <div class="ia-plans">
        <div class="ia-plan rv">
          <span class="kicker">Pro · $99</span>
          <h3>Read-only</h3>
          <p>The mix of visits your store gets. Storefront untouched.</p>
        </div>
        <div class="ia-plan feat rv">
          <span class="kicker">Growth · $199</span>
          <h3>Live</h3>
          <p>Intent suggest, the full Intent tab and the on/off test.</p>
        </div>
        <div class="ia-plan rv">
          <span class="kicker">Every new install</span>
          <h3>{REVERSE_TRIAL_DAYS} days of Growth</h3>
          <p>No card. Then Free — never locked.</p>
        </div>
      </div>
      <p class="ia-more rv"><a href="/pricing">Compare every plan →</a></p>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <section class="sec" style="padding-top:0">
    <div class="narrow">
      <div class="shead ctr rv" style="margin-bottom:2rem">
        <h2>Questions merchants ask</h2>
      </div>
      <div class="faq ia-faq rv">
        {FAQ.map((f) => (
          <details><summary>{f.q}<span class="pm"></span></summary><div class="ans" set:html={f.a} /></details>
        ))}
      </div>
      <p class="ia-more rv">The <a href={GUIDE_URL}>user guide</a> walks through every setting in the app.</p>
    </div>
  </section>

  <!-- ===================== CTA ===================== -->
  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="cta rv">
        <h2>See what your visits <em>came for.</em></h2>
        <p>Install free, look at the Intent tab, and switch it on only where you want it.</p>
        <div class="hero-cta" style="justify-content:center">
          <a href={APP_STORE_URL} class="btn btn-accent btn-lg">Get started <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          <BookDemo class="btn btn-ghost btn-lg">Book a demo</BookDemo>
        </div>
      </div>
    </div>
  </section>
</Base>

<style is:global>
  /* the five intents */
  .ia-modes { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  @media (min-width:768px){ .ia-modes { grid-template-columns:repeat(3, 1fr); } }
  @media (min-width:1024px){ .ia-modes { grid-template-columns:repeat(5, 1fr); } }
  .ia-mode { display:flex; flex-direction:column; align-items:flex-start; gap:6px; background:var(--surface);
    border:1px solid var(--line); border-radius:16px; padding:18px 16px; }
  .ia-ic { display:grid; place-items:center; width:42px; height:42px; border-radius:12px; margin-bottom:6px;
    background:var(--green-soft); border:1px solid var(--green-line); }
  .ia-ic svg { width:22px; height:22px; fill:none; stroke:var(--green-ink); stroke-width:1.8; stroke-linecap:round;
    stroke-linejoin:round; }
  .ia-mode h3 { font-size:1rem; font-weight:650; letter-spacing:-.015em; color:var(--ink); }
  .ia-mode p { font-size:var(--fs-caption); line-height:1.45; color:var(--ink-2); flex:1; }
  .ia-works { margin-top:4px; font-family:var(--mono); font-size:9.5px; font-weight:700; letter-spacing:.06em;
    text-transform:uppercase; color:var(--green-ink); background:var(--green-soft); border-radius:999px; padding:3px 8px; }
  @media (max-width:340px){ .ia-modes { grid-template-columns:1fr; } }

  .ia-mapsec { background:var(--bg-2); border-block:1px solid var(--line); }

  /* detail illustrations */
  .ia-viz { display:flex; justify-content:center; }
  .ia-panel { width:100%; max-width:440px; background:var(--surface); border:1px solid var(--line); border-radius:18px;
    padding:20px; box-shadow:0 1px 2px rgba(16,24,40,.04), 0 24px 48px -32px rgba(16,24,40,.22); }
  .ia-panel-k { display:block; font-family:var(--mono); font-size:10px; font-weight:700; letter-spacing:.1em;
    text-transform:uppercase; color:var(--muted); margin-bottom:14px; }
  .ia-panel-cap { margin-top:12px; text-align:center; font-family:var(--mono); font-size:9.5px; font-weight:600;
    letter-spacing:.06em; text-transform:uppercase; color:var(--faint); }
  .ia-bar { display:grid; grid-template-columns:110px 1fr 38px; align-items:center; gap:10px; padding:7px 0; }
  .ia-bar-l { font-size:.82rem; color:var(--ink-2); }
  .ia-bar-t { height:8px; border-radius:6px; background:var(--bg-2); overflow:hidden; }
  .ia-bar-t i { display:block; height:100%; border-radius:6px; background:var(--line-2); }
  .ia-bar-v { font-family:var(--mono); font-size:.76rem; color:var(--muted); text-align:right; }
  .ia-bar.on .ia-bar-l { color:var(--green-ink); font-weight:650; }
  .ia-bar.on .ia-bar-t i { background:var(--green); }
  .ia-bar.on .ia-bar-v { color:var(--green-ink); font-weight:700; }
  .ia-place { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:9px 0;
    border-top:1px solid var(--line); }
  .ia-place:first-of-type { border-top:0; }
  .ia-place-p { font-size:.86rem; font-weight:600; color:var(--ink); display:flex; flex-direction:column; }
  .ia-place-p small { font-weight:400; font-size:.74rem; color:var(--muted); }
  .ia-place-s { flex:none; font-family:var(--mono); font-size:9.5px; font-weight:700; letter-spacing:.06em;
    text-transform:uppercase; padding:3px 7px; border-radius:6px; color:var(--green-ink); background:var(--green-soft);
    border:1px solid var(--green-line); }
  .ia-place.off .ia-place-p { color:var(--muted); }
  .ia-place.off .ia-place-s { color:var(--muted); background:var(--bg-2); border-color:var(--line-2); }
  .ia-tagrow { display:grid; grid-template-columns:1fr auto auto; align-items:center; gap:10px; padding:9px 0;
    border-top:1px solid var(--line); }
  .ia-tagrow:first-of-type { border-top:0; }
  .ia-tagrow-p { font-size:.86rem; font-weight:600; color:var(--ink); min-width:0; overflow:hidden;
    text-overflow:ellipsis; white-space:nowrap; }
  .ia-tagrow-t { font-size:.78rem; color:var(--green-ink); background:var(--green-soft); border:1px solid var(--green-line);
    border-radius:999px; padding:2px 9px; white-space:nowrap; }
  .ia-tagrow-by { font-family:var(--mono); font-size:9.5px; font-weight:700; letter-spacing:.06em; text-transform:uppercase;
    color:var(--faint); min-width:64px; text-align:right; }
  .ia-tagrow-by.you { color:var(--ink); }
  @media (max-width:480px){
    .ia-tagrow { grid-template-columns:1fr auto; }
    .ia-tagrow-by { grid-column:2; min-width:0; }
  }

  /* plans */
  .ia-plans { display:grid; grid-template-columns:1fr; gap:12px; max-width:960px; margin:0 auto; }
  @media (min-width:768px){ .ia-plans { grid-template-columns:repeat(3, 1fr); } }
  .ia-plan { background:var(--surface); border:1px solid var(--line); border-radius:16px; padding:22px 20px; }
  .ia-plan.feat { border-color:var(--green-line); box-shadow:0 0 0 3px var(--green-soft); }
  .ia-plan h3 { margin-top:8px; font-size:1.2rem; font-weight:650; color:var(--ink); letter-spacing:-.015em; }
