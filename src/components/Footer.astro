---
import { SUPPORT_EMAIL, GUIDE_URL } from '../consts';
import BookDemo from './BookDemo.astro';
const year = 2026;
---
<footer class="site">
  <div class="wrap">
    <div class="foot">
      <div>
        <a href="/" class="logo" aria-label="QSortby home">
          <img src="/logo.svg" class="logomark" width="150" height="28" alt="QSortby" />
        </a>
        <p class="fd">Smart collection sorting for Shopify. QSortby turns live store signals into a storefront that merchandises itself — so the right products always lead.</p>
      </div>
      <div>
        <h2>Product</h2>
        <a href="/features/intent-ai">Intent AI</a>
        <a href="/integrations">Integrations</a>
        <a href="/pricing">Pricing</a>
        <a href={GUIDE_URL}>User guide</a>
      </div>
      <div>
        <h2>Company</h2>
        <a href="/support">Support</a>
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
        <a href={`mailto:${SUPPORT_EMAIL}`}>Contact</a>
      </div>
      <div>
        <h2>Get started</h2>
        <BookDemo>Book a demo</BookDemo>
        <a href="/pricing">Pricing</a>
      </div>
    </div>
    <div class="fbar">
      <span>© {year} QSortby. All rights reserved.</span>
      <span>Built for Shopify merchants. <a href="#" data-consent-open>Cookie settings</a></span>
    </div>
  </div>
</footer>
