---
/**
 * UPSELL AI — "how it works" detail, five sections under the page's How-it-works
 * steps. Same shape as components/MerchandisingFeatures.astro: copy + one
 * illustration per claim, alternating sides via the sitewide `.split`/
 * `.split-rev` classes. Self-contained `uf-*` styling — this page never
 * renders Offer.astro, MerchandisingHero/Features, or VisitorFeeds, so none
 * of THEIR classes exist here (see the astro-style-scoping memory).
 */
const SURFACES = [
  { name: 'Cart drawer', on: true },
  { name: 'Checkout', on: true },
  { name: 'Thank-you page', on: true },
  { name: 'Product page', on: false },
  { name: 'Popups', on: false },
  { name: 'Free-shipping bar', on: true },
];
---
<div class="split-list">
  <!-- 1 — six surfaces, one engine -->
  <div class="split rv">
    <div class="uf-copy">
      <h2>Turn every touchpoint into a chance to upsell</h2>
      <p class="lead">Cart drawer, checkout, product page, and more, each one is a spot where a shopper is already paying attention. Add a block to any of them and set the rule it follows, frequently bought together, best sellers, or trending, so it's suggesting the right thing at the right moment. The thank-you offer runs on the order-status page after payment, with every payment method and no risk to the sale you just won.</p>
    </div>
    <div class="uf-viz">
      <div class="uf-panel">
        <span class="uf-label">Touchpoints &middot; connected</span>
        {SURFACES.map((s) => (
          <div class="uf-srow">
            <span>{s.name}</span>
            <span class={s.on ? 'uf-stat on' : 'uf-stat'}>{s.on ? 'Live' : 'Off'}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- 2 — set the rule -->
  <div class="split split-rev rv">
    <div class="uf-copy">
      <h2>Set the rule behind each block</h2>
      <p class="lead">Pick what a block suggests — best sellers, trending, your own list, or one of the lists learned from your orders — then layer display rules on top: cart over $50, contains a tag, comes from a vendor, so it only shows when it actually fits. A pop-up can start from one cart product, the most expensive, the first in, or the one with most units.</p>
    </div>
    <div class="uf-viz">
      <div class="uf-panel">
        <span class="uf-label">Block rule</span>
        <div class="uf-rule"><span>Recommends</span><b>Bought together</b></div>
        <div class="uf-rule"><span>Starting from</span><b>Most expensive in cart</b></div>
        <span class="uf-label" style="margin-top:18px">Only show when</span>
        <div class="uf-chips">
          <span class="uf-chip">Cart &gt; $50</span>
          <span class="uf-chip">Tag: outdoor</span>
          <span class="uf-chip">Vendor: Trailhead</span>
        </div>
      </div>
    </div>
  </div>

  <!-- 2b — learned from orders. The four lists are services/storefront-data's
       `type`s (bought / added / viewed / similar), rebuilt nightly by
       workers/product-affinity + product-similar; a pair counts from two
       orders (MIN_PAIR_COUNT). Also what the popup's "How products are chosen"
       offers and the bought-together block reads. No counts are shown: they
       are the merchant's own, and the site must not invent one. -->
  <div class="split rv">
    <div class="uf-copy">
      <h2>Learned from your orders, rebuilt every night</h2>
      <p class="lead">QSortby keeps four lists for every product — what it is <b>bought</b> with, <b>added</b> to the cart with, <b>viewed</b> with, and what it is <b>similar</b> to — read from your own order lines and sessions and rebuilt nightly, so a pairing that stopped selling stops being offered. A pair has to appear in more than one order to count, so one unusual basket never becomes a recommendation.</p>
    </div>
    <div class="uf-viz">
      <div class="uf-panel">
        <span class="uf-label">Trail Runner &middot; related lists &middot; rebuilt nightly</span>
        {[
          { k: 'Bought together', items: ['Steel Bottle', 'Trail Socks', 'Running Cap'] },
          { k: 'Added together', items: ['Trail Socks', 'Everyday Tee'] },
          { k: 'Viewed together', items: ['Field Watch', 'Studio Headphones'] },
          { k: 'Similar', items: ['Road Runner', 'Trail Runner GTX'] },
        ].map((l) => (
          <div class="uf-list">
            <span class="uf-list-k">{l.k}</span>
            <span class="uf-list-v">{l.items.join(' · ')}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- 3 — never the wrong offer -->
  <div class="split rv">
    <div class="uf-copy">
      <h2>Never the wrong offer</h2>
      <p class="lead">A block skips what's already in the cart and never suggests something out of stock. The free-shipping bar only offers something that actually closes the gap, not a $5 item against $40 missing.</p>
    </div>
    <div class="uf-viz">
      <div class="uf-panel">
        <div class="uf-grow skip">
          <span class="gthumb"><img src="/products/sneaker.svg" alt="" loading="lazy" decoding="async" /></span>
          <span class="uf-gn">Trail Runner</span>
          <span class="uf-gtag">Already in cart</span>
        </div>
        <div class="uf-grow skip">
          <span class="gthumb"><img src="/products/headphones.svg" alt="" loading="lazy" decoding="async" /></span>
          <span class="uf-gn">Studio Headphones</span>
          <span class="uf-gtag">Out of stock</span>
        </div>
        <div class="uf-grow ok">
          <span class="gthumb"><img src="/products/bottle.svg" alt="" loading="lazy" decoding="async" /></span>
          <span class="uf-gn">Steel Bottle</span>
          <span class="uf-gtag ok">$18 &middot; closes the gap</span>
        </div>
      </div>
    </div>
  </div>

  <!-- 4 — re-ranked by why the visit came (Intent AI). The switch in the app is
       "Intent suggest" and reads the five intents; the twelve-mood model this
       section used to describe was retired. Labels are the app's own. -->
  <div class="split split-rev rv">
    <div class="uf-copy">
      <h2>Re-ranked by what the shopper came for</h2>
      <p class="lead">On Growth, switch on Intent suggest and the cart, popup, checkout and thank-you offers re-rank their own suggestions by why each visit came — someone buying a gift and someone replacing a product can see different offers from the same cart. A shopper with nothing read sees the normal order. Then the <a href="/features/intent-ai">Intent AI on/off test</a> holds a share of shoppers on the plain offers and compares how many in each group bought, so you read whether it paid instead of guessing.</p>
    </div>
    <div class="uf-viz">
      <div class="uf-panel dark">
        <div class="uf-moods">
          <div class="uf-mood">
            <span class="uf-mood-h">Replacing something</span>
            <div class="uf-mrow"><span class="gthumb"><img src="/products/box.svg" alt="" loading="lazy" decoding="async" /></span><span>Refill Pack</span></div>
            <div class="uf-mrow"><span class="gthumb"><img src="/products/candle-tin.svg" alt="" loading="lazy" decoding="async" /></span><span>Care Kit</span></div>
          </div>
          <div class="uf-mood accent">
            <span class="uf-mood-h b">Buying a gift</span>
            <div class="uf-mrow on"><span class="gthumb"><img src="/products/mug.svg" alt="" loading="lazy" decoding="async" /></span><span>Gift Wrap</span></div>
            <div class="uf-mrow"><span class="gthumb"><img src="/products/watch.svg" alt="" loading="lazy" decoding="async" /></span><span>Premium Upgrade</span></div>
          </div>
        </div>
        <p class="uf-mood-cap">Same cart, same moment — two reasons for the visit, two different suggestions.</p>
      </div>
    </div>
  </div>
</div>

<style is:global>
  .uf-viz { display:flex; }
  .uf-panel { flex:1; background:var(--surface); border:1px solid var(--line); border-radius:18px;
    padding:22px; box-shadow:0 1px 2px rgba(16,24,40,.04), 0 24px 48px -28px rgba(16,24,40,.22); }
  .uf-panel.dark { background:linear-gradient(165deg,#123227,#08160F); border-color:rgba(120,220,170,.16); }

  .uf-label { display:block; font-family:var(--mono); font-size:10px; font-weight:700;
    letter-spacing:.12em; text-transform:uppercase; color:var(--muted); margin-bottom:14px; }

  /* section 1 — connected surfaces */
  .uf-srow { display:flex; align-items:center; justify-content:space-between;
    padding:11px 0; border-top:1px solid var(--line); }
  .uf-srow:first-of-type { border-top:0; padding-top:0; }
  .uf-srow span:first-child { font-size:var(--fs-body); font-weight:600; color:var(--ink); }
  .uf-stat { font-family:var(--mono); font-size:10px; font-weight:700; letter-spacing:.06em;
    text-transform:uppercase; color:var(--faint); }
  .uf-stat.on { color:var(--green-ink); }

  /* section 2 — rule + display-rule chips */
  .uf-rule { display:flex; align-items:center; justify-content:space-between;
    padding-bottom:14px; margin-bottom:6px; border-bottom:1px solid var(--line); }
  .uf-rule span { font-size:var(--fs-body); color:var(--ink-2); }
  .uf-rule b { font-size:1.02rem; font-weight:650; color:var(--ink); letter-spacing:-.01em; }
  .uf-chips { display:flex; flex-wrap:wrap; gap:8px; }
  .uf-chip { font-family:var(--mono); font-size:11px; font-weight:600; color:var(--ink-2);
    background:var(--bg-2); border:1px solid var(--line); border-radius:999px; padding:6px 12px; }

  /* section 2b — the four learned lists */
  .uf-list { display:flex; flex-direction:column; gap:3px; padding:10px 0; border-top:1px solid var(--line); }
  .uf-list:first-of-type { border-top:0; padding-top:0; }
  .uf-list-k { font-family:var(--mono); font-size:10px; font-weight:700; letter-spacing:.08em;
    text-transform:uppercase; color:var(--green-ink); }
  .uf-list-v { font-size:var(--fs-body); font-weight:600; color:var(--ink); }

  /* section 3 — guardrails: skipped vs. valid rows */
  .uf-grow { display:flex; align-items:center; gap:10px; padding:10px 11px; border-radius:11px;
    background:var(--bg-2); border:1px solid var(--line); margin-bottom:10px; }
  .uf-grow:last-child { margin-bottom:0; }
  .uf-grow.skip { opacity:.55; }
  .uf-grow.skip .gthumb img { filter:grayscale(1); }
  .uf-grow.ok { background:var(--green-soft); border-color:var(--green-line); opacity:1; }
  .uf-gn { flex:1; min-width:0; font-size:.86rem; font-weight:600; color:var(--ink);
    white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .uf-gtag { flex:none; font-family:var(--mono); font-size:10px; font-weight:600; color:var(--muted); }
  .uf-gtag.ok { color:var(--green-ink); font-weight:700; }

  /* section 4 — two segments, dark card (matches the site's other
     "segment/personalize" panels: components/Offer.astro's dark tab card) */
  .uf-moods { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  .uf-mood { display:flex; flex-direction:column; gap:8px; }
  .uf-mood-h { font-family:var(--mono); font-size:9.5px; font-weight:700; text-transform:uppercase;
    letter-spacing:.1em; color:rgba(255,255,255,.42); }
  .uf-mood-h.b { color:var(--green-bright); }
  .uf-mrow { display:flex; align-items:center; gap:8px; padding:7px 9px; border-radius:9px;
    background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.07); }
  .uf-mrow span:last-child { font-size:11.5px; font-weight:600; color:rgba(255,255,255,.78);
    white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .uf-mrow.on { background:rgba(0,163,107,.18); border-color:rgba(43,217,150,.4); }
  .uf-mrow.on span:last-child { color:#fff; }
  .uf-mrow .gthumb { width:22px; height:22px; border-radius:6px; }
  .uf-mood-cap { margin-top:14px; text-align:center; font-family:var(--mono); font-size:9.5px;
    font-weight:600; text-transform:uppercase; letter-spacing:.1em; color:rgba(255,255,255,.34); }
</style>
