---
/**
 * INTENT AI — home-page teaser, linking to /features/intent-ai.
 *
 * Not held to the "shows its work" section's Free-plan rule: Intent AI ranks
 * only on Growth (read-only on Pro), and the copy says so rather than letting
 * a Free merchant expect it. Every line is still one the app shows — the five
 * intents by their in-app names, the Intent suggest switch, the Intent tab and
 * the Intent AI on/off test. Nothing about lift: the app has no figure for
 * that except each shop's own test.
 */
const INTENTS = ['Treating themselves', 'Replacing something', 'Buying a gift', 'Browsing', 'Close to buying'];
const POINTS = [
  { k: 'Reads', t: 'One visit at a time — no login, no purchase history. It commits to a reason only when the visit makes it clear.' },
  { k: 'Acts', t: 'Where you switch Intent suggest on: For You feeds and the cart, popup, checkout and thank-you upsells. One weighted signal, with its share of the score shown.' },
  { k: 'Proves', t: 'The Intent tab shows what each kind of visit bought, and the Intent AI on/off test measures whether it paid — on your own store.' },
];
---
<section class="sec" style="padding-top:0">
  <div class="wrap">
    <div class="band it-band rv">
      <div class="it-copy">
        <span class="eyebrow"><span class="dot"></span>Intent AI · Growth</span>
        <h2>Knows why each visitor came — and shows its work.</h2>
        <p>Every visit is read for one of five reasons people shop. Where you switch it on, your feed and upsells rank by it — and what it learns stays in testing, off your storefront.</p>
        <div class="it-chips" aria-label="The five intents">
          {INTENTS.map((i) => <span>{i}</span>)}
        </div>
        <a href="/features/intent-ai" class="btn btn-ghost it-link">How Intent AI works <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      </div>
      <ol class="it-points">
        {POINTS.map((p, i) => (
          <li>
            <span class="it-n">{String(i + 1).padStart(2, '0')}</span>
            <div><b>{p.k}</b><p>{p.t}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style is:global>
  .it-band { display:grid; grid-template-columns:1fr; gap:2rem; }
  @media (min-width:1024px){ .it-band { grid-template-columns:1.05fr 1fr; gap:3.5rem; align-items:center; } }
  .it-copy h2 { font-weight:600; font-size:1.75rem; line-height:1.16; letter-spacing:-.02em; margin-top:1rem; max-width:20ch; }
  .it-copy > p { margin-top:.85rem; color:var(--ink-2); line-height:1.6; max-width:48ch; font-size:1.0625rem; }
  .it-chips { display:flex; flex-wrap:wrap; gap:8px; margin-top:1.25rem; }
  .it-chips span { font-family:var(--mono); font-size:11px; font-weight:600; padding:6px 11px; border-radius:999px;
    color:var(--green-ink); background:var(--surface); border:1px solid var(--green-line); }
  .it-link { margin-top:1.5rem; }
  .it-points { list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:10px; }
  .it-points li { display:flex; gap:14px; align-items:flex-start; background:var(--surface); border:1px solid var(--line);
    border-radius:16px; padding:16px 18px; }
  .it-n { flex:none; font-family:var(--mono); font-size:11px; font-weight:700; letter-spacing:.08em; color:var(--green-ink);
    margin-top:3px; }
  .it-points b { display:block; font-size:1rem; font-weight:650; color:var(--ink); }
  .it-points p { margin-top:3px; font-size:var(--fs-caption); line-height:1.5; color:var(--ink-2); }
</style>
