---
/**
 * Small animated vignettes that sit at the top of the text cards on the home
 * page ("If you've said any of these…" and "Upsells that learn…"). Each one
 * shows the problem or mechanism the card describes, in flat UI pieces — no
 * product renders, so they read as interface, not illustration.
 *
 * Motion starts when the card's `.rv` wrapper gets `.in` (public/assets/app.js)
 * and loops with long holds. Transform/opacity/left/top/width only; with
 * reduced motion every vignette shows its end state, still.
 *
 * Catalog is the same fictional home-fragrance store as the intro video.
 */
interface Props { kind: 'sold' | 'new' | 'visitors' | 'ab' | 'scale' | 'why' | 'pairs' | 'goeswith' | 'proof' }
const { kind } = Astro.props;
const P = {
  vanilla: { n: 'Vanilla Oak Candle', c: '#F3E3C3' },
  cedar:   { n: 'Cedar & Sage Diffuser', c: '#D9E8D5' },
  linen:   { n: 'Linen Breeze Candle', c: '#DFE7F3' },
  fig:     { n: 'Wild Fig Room Spray', c: '#EBDCE8' },
  amber:   { n: 'Amber Musk Refill', c: '#F1DDC8' },
  wick:    { n: 'Wick Trimmer', c: '#E4E4E1' },
};
const grid = Array.from({ length: 40 }, (_, i) => ['#F3E3C3', '#D9E8D5', '#DFE7F3', '#EBDCE8', '#F1DDC8'][(i * 7 + (i >> 2)) % 5]);
---
<div class={`cv cv-${kind}`} aria-hidden="true">
  {kind === 'sold' && (<>
    <div class="cv-t s0 out"><span class="cv-sw" style="background:#E9E9E7"></span><b>Sold out</b><i></i></div>
    <div class="cv-t s1"><span class="cv-sw" style={`background:${P.vanilla.c}`}></span><i></i><i class="sh"></i></div>
    <div class="cv-t s2"><span class="cv-sw" style={`background:${P.cedar.c}`}></span><i></i><i class="sh"></i></div>
    <div class="cv-t s3"><span class="cv-sw" style={`background:${P.linen.c}`}></span><i></i><i class="sh"></i></div>
  </>)}

  {kind === 'new' && (<>
    {[P.vanilla, P.cedar, P.linen].map((p, i) => (
      <div class={`cv-r r${i}`}><span class="cv-dot" style={`background:${p.c}`}></span><span class="cv-n">{p.n}</span></div>
    ))}
    <div class="cv-r r3 new"><span class="cv-dot" style={`background:${P.fig.c}`}></span><span class="cv-n">{P.fig.n}</span><em>New</em></div>
  </>)}

  {kind === 'visitors' && (<>
    <div class="cv-col c0"><span class="cv-lb">Everyone</span>
      {[P.vanilla, P.cedar, P.linen].map((p, i) => <span class={`cv-mini m${i}`} style={`background:${p.c}`}></span>)}
    </div>
    <div class="cv-col c1"><span class="cv-lb">Buying a gift</span>
      <span class="cv-mini m0 g" style={`background:${P.vanilla.c}`}></span>
      <span class="cv-mini m1 g" style={`background:${P.cedar.c}`}></span>
      <span class="cv-mini m2 g hi" style={`background:${P.fig.c}`}></span>
    </div>
  </>)}

  {kind === 'ab' && (<>
    <div class="cv-bar ba"><span class="cv-k">A · old order</span><span class="cv-fill"></span></div>
    <div class="cv-bar bb"><span class="cv-k">B · new order</span><span class="cv-fill"></span></div>
    <em class="cv-chip">B ahead · same 14 days</em>
  </>)}

  {kind === 'scale' && (<>
    <div class="cv-grid">{grid.map((c, i) => <i style={`background:${c};--i:${(i % 8) + (i >> 3)}`}></i>)}</div>
    <em class="cv-chip">1 rule · every collection</em>
  </>)}

  {kind === 'why' && (<>
    <div class="cv-t solo"><span class="cv-sw" style={`background:${P.vanilla.c}`}></span><b>#1</b><i></i></div>
    <div class="cv-ws">
      {[['Sales', 42], ['Conversion', 28], ['In stock', 18], ['New', 12]].map(([k, v], i) => (
        <div class={`w w${i}`}><span>{k}</span><span class="cv-track"><span class="cv-fill" style={`--w:${Number(v) * 2}%`}></span></span><b>{v}%</b></div>
      ))}
    </div>
  </>)}

  {kind === 'pairs' && (<>
    <div class="cv-p p0"><span class="cv-sw" style={`background:${P.vanilla.c}`}></span><span class="cv-n">{P.vanilla.n}</span></div>
    <span class="cv-link"><span></span></span>
    <span class="cv-plus">+</span>
    <div class="cv-p p1"><span class="cv-sw" style={`background:${P.wick.c}`}></span><span class="cv-n">{P.wick.n}</span></div>
    <em class="cv-chip">Bought together in 14 orders</em>
  </>)}

  {kind === 'goeswith' && (<>
    <div class="cv-p p0"><span class="cv-sw" style={`background:${P.vanilla.c}`}></span><span class="cv-n">{P.vanilla.n}</span></div>
    <span class="cv-arrow">goes with</span>
    <div class="cv-slot">
      <div class="cv-p p1 old"><span class="cv-sw" style={`background:${P.cedar.c}`}></span><span class="cv-n">{P.cedar.n}</span></div>
      <div class="cv-p p1 chal"><span class="cv-sw" style={`background:${P.linen.c}`}></span><span class="cv-n">{P.linen.n}</span></div>
    </div>
    <div class="cv-lead"><span class="cv-k">Challenger's lead</span><span class="cv-track"><span class="cv-fill"></span></span><span class="cv-k">7 days</span></div>
  </>)}

  {kind === 'proof' && (<>
    <div class="cv-bar ba"><span class="cv-k">Your best sellers</span><span class="cv-fill"></span></div>
    <div class="cv-bar bb"><span class="cv-k">Learned picks</span><span class="cv-fill"></span></div>
    <div class="cv-nights">
      <span class="n n0">Night 1</span><span class="n n1">Night 2</span><span class="n n2">Night 3</span>
      <em class="cv-ready">Ready</em>
    </div>
  </>)}
</div>

<style is:global>
  .cv { position:relative; height:108px; margin:-4px 0 18px; border-radius:14px; overflow:hidden;
    background:linear-gradient(180deg,#F8FAF9,#F2F5F3); border:1px solid var(--line); font-size:10px; color:var(--ink-2); }
  .cv b, .cv em { font-style:normal; }
  .cv-sw { display:block; border-radius:6px; }
  .cv-chip { position:absolute; right:8px; bottom:8px; padding:3px 9px; border-radius:999px; background:#fff; border:1px solid var(--green-line);
    color:var(--green-ink); font-weight:600; font-size:10px; }
  .cv-track { position:relative; display:block; height:6px; border-radius:99px; background:#E6EAE8; overflow:hidden; }
  .cv-fill { position:absolute; inset:0 auto 0 0; border-radius:99px; background:var(--green); }

  /* tiles */
  .cv-t { position:absolute; top:12px; width:20%; height:82px; padding:6px; border-radius:10px; background:#fff;
    border:1px solid var(--line); box-shadow:0 1px 2px rgba(16,24,40,.05); }
  .cv-t .cv-sw { height:42px; }
  .cv-t i { display:block; height:5px; margin-top:7px; border-radius:3px; background:#E3E7E5; }
  .cv-t i.sh { width:55%; margin-top:4px; }
  .cv-t b { position:absolute; left:10px; top:10px; padding:1px 6px; border-radius:99px; background:#fff; color:#B4463E; font-size:9px; font-weight:600;
    border:1px solid #F0D6D3; }
  .cv-t.out { opacity:.6; }

  /* 1 · sold out sinks to the back, then returns on restock */
  .cv-sold .s0 { left:5%; } .cv-sold .s1 { left:28.3%; } .cv-sold .s2 { left:51.6%; } .cv-sold .s3 { left:75%; }
  .rv.in .cv-sold .s0 { animation:cv-s0 7s var(--ease) infinite; }
  .rv.in .cv-sold .s1 { animation:cv-s1 7s var(--ease) infinite; }
  .rv.in .cv-sold .s2 { animation:cv-s2 7s var(--ease) infinite; }
  .rv.in .cv-sold .s3 { animation:cv-s3 7s var(--ease) infinite; }
  @keyframes cv-s0 { 0%,20% { left:5%; } 35%,80% { left:75%; } 95%,100% { left:5%; } }
  @keyframes cv-s1 { 0%,20% { left:28.3%; } 35%,80% { left:5%; } 95%,100% { left:28.3%; } }
  @keyframes cv-s2 { 0%,20% { left:51.6%; } 35%,80% { left:28.3%; } 95%,100% { left:51.6%; } }
  @keyframes cv-s3 { 0%,20% { left:75%; } 35%,80% { left:51.6%; } 95%,100% { left:75%; } }

  /* 2 · a new product climbs from the bottom */
  .cv-r { position:absolute; left:12px; right:12px; height:20px; display:flex; align-items:center; gap:8px; padding:0 8px;
    border-radius:8px; background:#fff; border:1px solid var(--line); }
  .cv-r .cv-dot { width:12px; height:12px; border-radius:4px; flex:none; }
  .cv-r .cv-n { flex:1; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; color:var(--ink); font-weight:500; }
  .cv-r em { padding:1px 7px; border-radius:99px; background:var(--green-soft); color:var(--green-ink); font-weight:700; font-size:9px; }
  .cv-r.new { border-color:var(--green-line); }
  .cv-new .r0 { top:8px; } .cv-new .r1 { top:32px; } .cv-new .r2 { top:56px; } .cv-new .r3 { top:80px; }
  .rv.in .cv-new .r0 { animation:cv-n0 7s var(--ease) infinite; }
  .rv.in .cv-new .r1 { animation:cv-n1 7s var(--ease) infinite; }
  .rv.in .cv-new .r2 { animation:cv-n2 7s var(--ease) infinite; }
  .rv.in .cv-new .r3 { animation:cv-n3 7s var(--ease) infinite; }
  @keyframes cv-n0 { 0%,20% { top:8px; } 35%,80% { top:32px; } 95%,100% { top:8px; } }
  @keyframes cv-n1 { 0%,20% { top:32px; } 35%,80% { top:56px; } 95%,100% { top:32px; } }
  @keyframes cv-n2 { 0%,20% { top:56px; } 35%,80% { top:80px; } 95%,100% { top:56px; } }
  @keyframes cv-n3 { 0%,20% { top:80px; } 35%,80% { top:8px; } 95%,100% { top:80px; } }

  /* 3 · same shelf for everyone vs. one built for this visit */
  .cv-col { position:absolute; top:10px; bottom:10px; width:43%; border-radius:10px; background:#fff; border:1px solid var(--line); padding:8px; }
  .cv-col.c0 { left:5%; } .cv-col.c1 { right:5%; border-color:var(--green-line); }
  .cv-lb { display:block; font-weight:600; color:var(--ink); margin-bottom:4px; }
  .c1 .cv-lb { color:var(--green-ink); }
  .cv-mini { position:absolute; top:28px; width:27%; height:50px; border-radius:7px; }
  .cv-mini.m0 { left:6%; } .cv-mini.m1 { left:36.5%; } .cv-mini.m2 { left:67%; }
  .cv-mini.hi { box-shadow:0 0 0 2px var(--green); }
  .rv.in .cv-visitors .g.m0 { animation:cv-v0 6s var(--ease) infinite; }
  .rv.in .cv-visitors .g.m1 { animation:cv-v1 6s var(--ease) infinite; }
  .rv.in .cv-visitors .g.m2 { animation:cv-v2 6s var(--ease) infinite; }
  @keyframes cv-v0 { 0%,25% { left:6%; } 40%,85% { left:36.5%; } 100% { left:6%; } }
  @keyframes cv-v1 { 0%,25% { left:36.5%; } 40%,85% { left:67%; } 100% { left:36.5%; } }
  @keyframes cv-v2 { 0%,25% { left:67%; box-shadow:0 0 0 0 transparent; } 40%,85% { left:6%; box-shadow:0 0 0 2px var(--green); } 100% { left:67%; box-shadow:0 0 0 0 transparent; } }

  /* 4 · A/B: the new order is measured against the old */
  .cv-bar { position:absolute; left:14px; right:14px; display:grid; grid-template-columns:96px 1fr; align-items:center; gap:10px; }
  .cv-bar.ba { top:20px; } .cv-bar.bb { top:44px; }
  .cv-bar .cv-k { font-weight:600; color:var(--ink); }
  .cv-bar .cv-fill { position:relative; display:block; height:12px; border-radius:6px; }
  .cv-bar.ba .cv-fill { width:52%; background:#CDD3D0; }
  .cv-bar.bb .cv-fill { width:52%; background:var(--green); }
  .rv.in .cv-ab .bb .cv-fill { animation:cv-grow 6s var(--ease) infinite; }
  .rv.in .cv-ab .cv-chip { animation:cv-pop 6s var(--ease) infinite; }
  @keyframes cv-grow { 0%,15% { width:52%; } 45%,90% { width:70%; } 100% { width:52%; } }
  @keyframes cv-pop { 0%,40% { opacity:0; transform:translateY(4px); } 50%,90% { opacity:1; transform:none; } 100% { opacity:0; } }
  .cv-ab .cv-chip { left:120px; right:auto; bottom:12px; }

  /* 5 · one rule over hundreds of products */
  .cv-grid { position:absolute; inset:10px 10px 32px; display:grid; grid-template-columns:repeat(8,1fr); grid-auto-rows:1fr; gap:4px; }
  .cv-grid i { border-radius:4px; border:1px solid rgba(16,24,40,.05); }
  .rv.in .cv-scale .cv-grid i { animation:cv-wave 4.2s ease-in-out infinite; animation-delay:calc(var(--i) * 90ms); }
  @keyframes cv-wave { 0%,60%,100% { box-shadow:none; transform:none; } 20% { box-shadow:0 0 0 2px var(--green); transform:scale(.92); } }

  /* 6 · why a product ranks where it does */
  .cv-t.solo { left:5%; width:26%; }
  .cv-t.solo b { color:var(--green-ink); border-color:var(--green-line); }
  .cv-ws { position:absolute; left:36%; right:12px; top:14px; display:grid; gap:6px; }
  .cv-ws .w { display:grid; grid-template-columns:62px 1fr 26px; align-items:center; gap:8px; }
  .cv-ws .w b { color:var(--ink); font-weight:600; text-align:right; }
  .cv-ws .cv-fill { width:var(--w); }
  .rv.in .cv-ws .cv-fill { animation:cv-bar 6s var(--ease) infinite; }
  .rv.in .cv-ws .w1 .cv-fill { animation-delay:.15s; } .rv.in .cv-ws .w2 .cv-fill { animation-delay:.3s; } .rv.in .cv-ws .w3 .cv-fill { animation-delay:.45s; }
  @keyframes cv-bar { 0% { width:0; } 25%,90% { width:var(--w); } 100% { width:0; } }

  /* product pills (upsell cards) */
  .cv-p { position:absolute; display:flex; align-items:center; gap:7px; width:40%; padding:6px; border-radius:10px; background:#fff;
    border:1px solid var(--line); box-shadow:0 1px 2px rgba(16,24,40,.05); }
  .cv-p .cv-sw { width:24px; height:24px; flex:none; }
  .cv-p .cv-n { font-weight:600; color:var(--ink); line-height:1.25; }

  /* 7 · bought together, from real orders */
  .cv-pairs .p0 { left:5%; top:14px; } .cv-pairs .p1 { right:5%; top:14px; }
  .cv-link { position:absolute; left:45%; right:45%; top:32px; height:2px; }
  .cv-link span { display:block; height:100%; background:var(--green); transform-origin:left; }
  .cv-plus { position:absolute; left:50%; top:22px; width:20px; height:20px; margin-left:-10px; border-radius:50%; display:grid; place-items:center;
    background:var(--green); color:#fff; font-weight:700; font-size:14px; line-height:1; }
  .cv-pairs .cv-chip { left:50%; right:auto; bottom:12px; transform:translateX(-50%); }
  .rv.in .cv-pairs .cv-link span { animation:cv-draw 6s var(--ease) infinite; }
  .rv.in .cv-pairs .cv-plus { animation:cv-plus 6s var(--ease) infinite; }
  .rv.in .cv-pairs .cv-chip { animation:cv-chip 6s var(--ease) infinite; }
  @keyframes cv-draw { 0%,10% { transform:scaleX(0); } 30%,90% { transform:scaleX(1); } 100% { transform:scaleX(0); } }
  @keyframes cv-plus { 0%,25% { transform:scale(0); } 35%,90% { transform:scale(1); } 100% { transform:scale(0); } }
  @keyframes cv-chip { 0%,35% { opacity:0; } 45%,90% { opacity:1; } 100% { opacity:0; } }

  /* 8 · the goes-with partner is swapped only after a held lead */
  .cv-goeswith .p0 { left:5%; top:12px; }
  .cv-arrow { position:absolute; left:46%; top:20px; width:8%; text-align:center; font-size:9px; color:var(--muted); }
  .cv-slot { position:absolute; right:5%; top:12px; width:40%; height:38px; }
  .cv-slot .cv-p { inset:0; width:auto; }
  .cv-slot .chal { opacity:0; border-color:var(--green-line); }
  .cv-lead { position:absolute; left:5%; right:5%; bottom:12px; display:grid; grid-template-columns:auto 1fr auto; align-items:center; gap:10px; }
  .cv-lead .cv-k { font-weight:600; color:var(--ink); }
  .cv-lead .cv-fill { width:100%; }
  .rv.in .cv-goeswith .cv-lead .cv-fill { animation:cv-lead 7s linear infinite; }
  .rv.in .cv-goeswith .old { animation:cv-out 7s var(--ease) infinite; }
  .rv.in .cv-goeswith .chal { animation:cv-in 7s var(--ease) infinite; }
  @keyframes cv-lead { 0% { width:0; } 55%,90% { width:100%; } 100% { width:0; } }
  @keyframes cv-out { 0%,55% { opacity:1; transform:none; } 62%,92% { opacity:0; transform:translateY(-8px); } 100% { opacity:1; transform:none; } }
  @keyframes cv-in { 0%,55% { opacity:0; transform:translateY(8px); } 62%,92% { opacity:1; transform:none; } 100% { opacity:0; } }

  /* 9 · learned picks must beat the best sellers three nights running */
  .cv-proof .cv-bar.ba { top:12px; } .cv-proof .cv-bar.bb { top:34px; }
  .cv-proof .cv-bar { grid-template-columns:104px 1fr; }
  .cv-proof .ba .cv-fill { width:58%; }
  .cv-proof .bb .cv-fill { width:66%; }
  .cv-nights { position:absolute; left:14px; right:14px; bottom:10px; display:flex; align-items:center; gap:6px; }
  .cv-nights .n { padding:3px 8px; border-radius:99px; border:1px solid var(--line); background:#fff; color:var(--muted); font-weight:600; }
  .cv-ready { margin-left:auto; padding:3px 10px; border-radius:99px; background:var(--green); color:#fff; font-weight:700; }
  .rv.in .cv-proof .bb .cv-fill { animation:cv-pk 8s var(--ease) infinite; }
  .rv.in .cv-proof .n0 { animation:cv-night 8s infinite; }
  .rv.in .cv-proof .n1 { animation:cv-night 8s infinite; animation-delay:.9s; }
  .rv.in .cv-proof .n2 { animation:cv-night 8s infinite; animation-delay:1.8s; }
  .rv.in .cv-proof .cv-ready { animation:cv-ready 8s var(--ease) infinite; }
  @keyframes cv-pk { 0% { width:40%; } 30%,92% { width:66%; } 100% { width:40%; } }
  @keyframes cv-night { 0%,20% { background:#fff; color:var(--muted); border-color:var(--line); } 26%,88% { background:var(--green-soft); color:var(--green-ink); border-color:var(--green-line); } 95%,100% { background:#fff; color:var(--muted); border-color:var(--line); } }
  @keyframes cv-ready { 0%,48% { opacity:0; transform:scale(.8); } 55%,90% { opacity:1; transform:none; } 100% { opacity:0; } }

  @media (prefers-reduced-motion:reduce) {
    .rv.in .cv * { animation:none !important; }
    .cv-sold .s0 { left:75%; } .cv-sold .s1 { left:5%; } .cv-sold .s2 { left:28.3%; } .cv-sold .s3 { left:51.6%; }
    .cv-new .r3 { top:8px; } .cv-new .r0 { top:32px; } .cv-new .r1 { top:56px; } .cv-new .r2 { top:80px; }
    .cv-ab .bb .cv-fill { width:70%; }
    .cv-slot .old { opacity:0; } .cv-slot .chal { opacity:1; }
  }
</style>
