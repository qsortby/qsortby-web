---
/**
 * INTENT AI — the ways a merchant checks it, one small picture each
 * (/features/intent-ai). Each card is a picture plus one line; the detail
 * lives in the app, where the merchant can read it against their own store.
 *
 * What each picture claims, and where the app shows it:
 *   heatmap   — the Intent tab's "When it peaks", hour by hour, in the
 *               store's own time zone (the grid's values are illustration)
 *   orders    — "Checked against orders": the three order facts that can
 *               confirm a reading (gift shipped to someone else, a repeat
 *               buy, a pick from an earlier visit — intent-fit.ts)
 *   tags      — "Do the tags match what shoppers buy?": an intent's shoppers
 *               against everyone else; a pattern, not causation
 *   test      — the Intent AI on/off test: split by shopper (50/50 by
 *               default), share who bought anything, read at the planned end
 *               of 2–6 whole weeks, with a check that the split is fair
 *
 * Self-contained `ip-` classes.
 */
// A deterministic heatmap: two daily peaks, stronger at the weekend.
const DAYS = ['M', 'T', 'W', 'T', 'F', 'S', 'S'];
const HOURS = 12;
const cell = (d: number, h: number) => {
  const evening = Math.exp(-((h - 9) ** 2) / 4);
  const lunch = 0.55 * Math.exp(-((h - 4) ** 2) / 2);
  const weekend = d >= 5 ? 1.25 : 1;
  return Math.min(1, (0.12 + evening + lunch) * weekend * 0.85);
};
const ORDERS = [
  { ic: 'gift', fact: 'Shipped to someone else', read: 'Buying a gift' },
  { ic: 'again', fact: 'Bought the same thing again', read: 'Replacing something' },
  { ic: 'pin', fact: 'Picked out on an earlier visit', read: 'Close to buying' },
];
const ICON: Record<string, string> = {
  gift: '<rect x="3" y="8" width="18" height="13" rx="2"/><path d="M12 8v13M3 12.5h18"/><path d="M12 8c-1.5-3.2-5.5-3.2-5.5-.6C6.5 8 8 8 12 8zm0 0c1.5-3.2 5.5-3.2 5.5-.6C17.5 8 16 8 12 8z"/>',
  again: '<path d="M19.5 11A7.5 7.5 0 0 0 5.7 7"/><path d="M5 3.5V7.5h4"/><path d="M4.5 13a7.5 7.5 0 0 0 13.8 4"/><path d="M19 20.5v-4h-4"/>',
  pin: '<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.3"/>',
};
---
<div class="ip">
  <div class="ip-card rv">
    <div class="ip-viz">
      <div class="ip-heat" aria-hidden="true">
        {DAYS.map((d, di) => (
          <div class="ip-hrow">
            <span>{d}</span>
            {Array.from({ length: HOURS }, (_, h) => <i style={`--a:${cell(di, h).toFixed(2)}`}></i>)}
          </div>
        ))}
        <div class="ip-hrow ip-hx"><span></span><em>Morning</em><em>Afternoon</em><em>Evening</em></div>
      </div>
    </div>
    <span class="kicker">The Intent tab</span>
    <h3>When each reason peaks</h3>
    <p>Hour by hour, in your store’s own time zone.</p>
  </div>

  <div class="ip-card rv">
    <div class="ip-viz ip-orders">
      {ORDERS.map((o) => (
        <div class="ip-o">
          <svg viewBox="0 0 24 24" set:html={ICON[o.ic]} />
          <span class="ip-of">{o.fact}</span>
          <span class="ip-or">{o.read} <b>✓</b></span>
        </div>
      ))}
    </div>
    <span class="kicker">Checked against orders</span>
    <h3>Did the orders agree?</h3>
    <p>Orders that can confirm a reading are counted against it.</p>
  </div>

  <div class="ip-card rv">
    <div class="ip-viz ip-tags" aria-hidden="true">
      <span class="ip-tq">Bought gift-tagged products</span>
      <div class="ip-tb on"><span>Gift shoppers</span><i style="--w:78%"></i></div>
      <div class="ip-tb"><span>Everyone else</span><i style="--w:34%"></i></div>
      <span class="ip-ill">Illustration</span>
    </div>
    <span class="kicker">Tags vs purchases</span>
    <h3>Do the tags match what sells?</h3>
    <p>A pattern to check — not proof that intent caused it.</p>
  </div>

  <div class="ip-card ip-wide rv">
    <div class="ip-viz ip-test" aria-hidden="true">
      <div class="ip-arms">
        <div class="ip-arm on"><span>With Intent AI</span><div class="ip-dots">{Array.from({ length: 18 }, () => <i></i>)}</div></div>
        <div class="ip-arm"><span>Without</span><div class="ip-dots">{Array.from({ length: 18 }, () => <i></i>)}</div></div>
      </div>
      <span class="ip-tarrow"></span>
      <div class="ip-measure">
        <span class="ip-mk">Share who bought anything</span>
        <div class="ip-mb on"><i></i><b>?</b></div>
        <div class="ip-mb"><i></i><b>?</b></div>
        <span class="ip-end">Read once · at the planned end</span>
      </div>
    </div>
    <span class="kicker">Intent AI on/off test</span>
    <h3>The one number that settles it</h3>
    <p>Shoppers split in two, measured over 2–6 whole weeks — and no verdict if the split itself is off.</p>
  </div>
</div>
<p class="ip-note rv">Revenue is credited by last touch and labelled <b>influenced</b> — never “caused”.</p>

<style is:global>
  .ip { display:grid; grid-template-columns:1fr; gap:14px; }
  @media (min-width:768px){ .ip { grid-template-columns:1fr 1fr; } }
  @media (min-width:1100px){ .ip { grid-template-columns:repeat(3, 1fr); } .ip-wide { grid-column:1 / -1; } }
  .ip-card { display:flex; flex-direction:column; background:var(--surface); border:1px solid var(--line);
    border-radius:18px; padding:18px 18px 20px; }
  .ip-card .kicker { display:block; margin-top:16px; }
  .ip-card h3 { margin-top:6px; font-size:1.12rem; font-weight:650; letter-spacing:-.015em; color:var(--ink); }
  .ip-card p { margin-top:4px; font-size:var(--fs-caption); line-height:1.5; color:var(--ink-2); }
  .ip-viz { border-radius:13px; background:var(--bg-2); border:1px solid var(--line); padding:14px; min-height:150px;
    display:flex; flex-direction:column; justify-content:center; }

  .ip-heat { display:flex; flex-direction:column; gap:3px; }
  .ip-hrow { display:grid; grid-template-columns:14px repeat(12, 1fr); gap:3px; align-items:center; }
  .ip-hrow span { font-family:var(--mono); font-size:9px; color:var(--faint); }
  .ip-hrow i { display:block; aspect-ratio:1; border-radius:3px; background:var(--green); opacity:calc(.08 + var(--a) * .92); }
  .ip-hx { margin-top:3px; grid-template-columns:14px repeat(3, 1fr); }
  .ip-hx em { font-style:normal; font-family:var(--mono); font-size:9px; color:var(--faint); text-align:center; }

  .ip-orders { gap:8px; }
  .ip-o { display:grid; grid-template-columns:20px 1fr; gap:2px 10px; align-items:center; padding:8px 10px;
    border-radius:10px; background:var(--surface); border:1px solid var(--line); }
  .ip-o svg { grid-row:1 / span 2; width:18px; height:18px; fill:none; stroke:var(--green-ink); stroke-width:1.8;
    stroke-linecap:round; stroke-linejoin:round; }
  .ip-of { font-size:.8rem; color:var(--ink); font-weight:600; }
  .ip-or { font-family:var(--mono); font-size:9.5px; font-weight:700; letter-spacing:.04em; text-transform:uppercase;
    color:var(--green-ink); }
  .ip-or b { color:var(--green); }

  .ip-tags { gap:10px; position:relative; }
  .ip-tq { font-family:var(--mono); font-size:9.5px; font-weight:700; letter-spacing:.08em; text-transform:uppercase;
    color:var(--muted); }
  .ip-tb { display:grid; grid-template-columns:96px 1fr; align-items:center; gap:10px; }
  .ip-tb span { font-size:.8rem; color:var(--ink-2); }
  .ip-tb i { display:block; height:12px; border-radius:6px; background:var(--line-2); width:var(--w); }
  .ip-tb.on span { color:var(--green-ink); font-weight:650; }
  .ip-tb.on i { background:linear-gradient(90deg,var(--green),var(--green-bright)); }
  .ip-ill { position:absolute; right:12px; bottom:10px; font-family:var(--mono); font-size:8.5px; letter-spacing:.08em;
    text-transform:uppercase; color:var(--faint); }

  .ip-test { display:grid; grid-template-columns:1fr; gap:14px; align-items:center; }
  @media (min-width:768px){ .ip-test { grid-template-columns:auto 56px 1fr; gap:22px; } }
  .ip-arms { display:grid; grid-template-columns:auto auto; gap:22px; justify-content:start; }
  .ip-arm span { display:block; font-family:var(--mono); font-size:9.5px; font-weight:700; letter-spacing:.08em;
    text-transform:uppercase; color:var(--muted); margin-bottom:8px; }
  .ip-arm.on span { color:var(--green-ink); }
  .ip-dots { display:grid; grid-template-columns:repeat(6, 14px); gap:6px; }
  .ip-dots i { display:block; aspect-ratio:1; border-radius:50%; background:var(--line-2); }
  .ip-arm.on .ip-dots i { background:var(--green); }
  .ip-tarrow { display:none; }
  @media (min-width:768px){
    .ip-tarrow { display:block; height:2px; background:var(--green-line); position:relative; }
    .ip-tarrow::after { content:""; position:absolute; right:0; top:-4px; width:8px; height:8px;
      border-right:2px solid var(--green); border-top:2px solid var(--green); transform:rotate(45deg); }
  }
  .ip-measure { display:flex; flex-direction:column; gap:8px; }
  .ip-mk { font-family:var(--mono); font-size:9.5px; font-weight:700; letter-spacing:.08em; text-transform:uppercase;
    color:var(--muted); }
  .ip-mb { display:grid; grid-template-columns:1fr 18px; align-items:center; gap:8px; }
  .ip-mb i { display:block; height:12px; border-radius:6px; background:repeating-linear-gradient(90deg,var(--line-2) 0 6px,transparent 6px 10px); }
  .ip-mb.on i { background:repeating-linear-gradient(90deg,var(--green) 0 6px,transparent 6px 10px); }
  .ip-mb b { font-family:var(--mono); font-size:.8rem; color:var(--muted); text-align:center; }
  .ip-end { margin-top:4px; align-self:flex-start; font-family:var(--mono); font-size:9.5px; font-weight:700;
    letter-spacing:.06em; text-transform:uppercase; color:var(--green-ink); background:var(--green-soft);
    border:1px solid var(--green-line); border-radius:999px; padding:3px 9px; }

  .ip-note { margin-top:1.25rem; text-align:center; font-size:var(--fs-caption); color:var(--muted); }
  .ip-note b { color:var(--ink); }
</style>
