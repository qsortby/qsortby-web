---
/**
 * Intro video — click-to-play YouTube embed (a "facade").
 *
 * The video lives on YouTube (ID in consts.ts → INTRO_VIDEO_ID). Until the
 * visitor presses play, the frame is just our own poster image and a button —
 * no YouTube iframe, script or cookie. A YouTube iframe costs ~1 MB of JS and
 * several third-party requests the moment it renders, on a section most
 * visitors scroll past. The click swaps in the iframe with autoplay, from
 * youtube-nocookie.com so YouTube sets no cookies until playback.
 *
 * Without JS the play button is a plain link to the video on YouTube.
 *
 * Poster: public/video/qsortby-intro-youtube.jpg — the video's own YouTube
 * thumbnail, self-hosted so it loads from our CDN. If the thumbnail on YouTube
 * changes, re-download it:
 *   curl -o public/video/qsortby-intro-youtube.jpg \
 *     https://i.ytimg.com/vi/<ID>/maxresdefault.jpg
 */
import { INTRO_VIDEO_ID } from '../consts';

interface Props {
  /** Heading above the player. */
  heading?: string;
  /** One line under the heading. */
  lead?: string;
  /** Shown on the play button, e.g. "2:05". Omit if you'd rather not commit. */
  duration?: string;
}

const {
  heading = 'Watch it sort the collection — then grow the order.',
  lead = 'Two minutes, no signup: the collection re-ranks itself on live demand, then the same engine goes to work on the basket — bought-together on the product page, a free-shipping nudge in the cart, and an offer at checkout and after it.',
  duration,
} = Astro.props;

const watchUrl = `https://www.youtube.com/watch?v=${INTRO_VIDEO_ID}`;
const embedUrl = `https://www.youtube-nocookie.com/embed/${INTRO_VIDEO_ID}?autoplay=1&rel=0&playsinline=1`;
---

<section class="sec alt" style="padding-top:0">
  <div class="wrap">
    <div class="shead ctr shead-lg rv" style="margin-bottom:2rem">
      <h2>{heading}</h2>
      <p class="lead-c">{lead}</p>
    </div>

    <div class="vplayer rv" id="introVideo" data-embed={embedUrl}>
      <img src="/video/qsortby-intro-youtube.jpg" alt="" width="1280" height="720" loading="lazy" decoding="async" />
      <a class="vplay" href={watchUrl} target="_blank" rel="noopener" aria-label="Play the QSortby introduction">
        <span class="vplay-pill">
          <span class="vplay-ring">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
          </span>
          <span class="vplay-txt">Watch the intro{duration && <span class="vplay-dur"> · {duration}</span>}</span>
        </span>
      </a>
    </div>
  </div>
</section>

<script is:inline>
  // One click handler, no framework. The link stays a working fallback: if
  // this never runs, the button opens the video on YouTube.
  (() => {
    const box = document.getElementById('introVideo');
    const btn = box && box.querySelector('.vplay');
    if (!btn) return;
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const f = document.createElement('iframe');
      f.src = box.dataset.embed;
      f.title = 'QSortby product introduction';
      f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      f.referrerPolicy = 'strict-origin-when-cross-origin';
      f.allowFullscreen = true;
      box.replaceChildren(f);
      f.focus();
    });
  })();
</script>

<style>
  /* Sized by aspect ratio rather than a fixed height so the frame can't shift
     layout while the poster loads. */
  .vplayer {
    position: relative;
    max-width: 900px;
    margin-inline: auto;
    aspect-ratio: 16 / 9;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--grad-mint);
    box-shadow: 0 30px 60px -40px rgba(16, 24, 40, 0.35);
  }
  .vplayer img,
  .vplayer iframe {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
  }

  /* The overlay covers the whole frame (the entire poster is the play
     target), but the visible button is one pill at the bottom centre: the
     YouTube thumbnail is a designed frame with copy and a product card, and
     a button in the middle would sit on top of them. */
  .vplay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: clamp(14px, 4%, 30px);
    background: transparent;
    cursor: pointer;
    font: inherit;
    text-decoration: none;
  }
  .vplay-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px 7px 7px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--bg);
    box-shadow: 0 12px 28px -12px rgba(30, 30, 26, 0.55);
    transition: transform 0.18s ease, background 0.18s ease;
  }
  .vplay-ring {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--green);
  }
  .vplay-ring svg {
    width: 14px;
    height: 14px;
    fill: #fff;
    margin-left: 2px;
  }
  .vplay-txt {
    font-size: 13.5px;
    font-weight: 600;
    white-space: nowrap;
  }
  .vplay-dur {
    font-weight: 500;
    opacity: 0.6;
  }
  .vplay:hover .vplay-pill,
  .vplay:focus-visible .vplay-pill {
    transform: translateY(-2px);
    background: var(--btn-h);
  }
  .vplay:focus-visible {
    outline: none;
  }
  .vplay:focus-visible .vplay-pill {
    outline: 2px solid var(--green);
    outline-offset: 3px;
  }
  @media (max-width: 560px) {
    .vplay { padding-bottom: 10px; }
    .vplay-pill { gap: 7px; padding: 4px 12px 4px 4px; }
    .vplay-ring { width: 24px; height: 24px; }
    .vplay-ring svg { width: 11px; height: 11px; }
    .vplay-txt { font-size: 11.5px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .vplay-pill {
      transition: none;
    }
    .vplay:hover .vplay-pill,
    .vplay:focus-visible .vplay-pill {
      transform: none;
    }
  }
</style>
