---
/**
 * Intro video — click-to-play YouTube embed (a "facade").
 *
 * The video lives on YouTube (ID in consts.ts → INTRO_VIDEO_ID). Until the
 * visitor presses play, the frame is just our own poster image and a button —
 * no YouTube iframe, script or cookie. A YouTube iframe costs ~1 MB of JS and
 * several third-party requests the moment it renders, on a section most
 * visitors scroll past. The click swaps in the iframe with autoplay, from
 * youtube-nocookie.com so YouTube sets no cookies until playback.
 *
 * Without JS the play button is a plain link to the video on YouTube.
 *
 * Poster: public/video/qsortby-intro-youtube.jpg — the video's own YouTube
 * thumbnail, self-hosted so it loads from our CDN. If the thumbnail on YouTube
 * changes, re-download it:
 *   curl -o public/video/qsortby-intro-youtube.jpg \
 *     https://i.ytimg.com/vi/<ID>/maxresdefault.jpg
 */
import { INTRO_VIDEO_ID } from '../consts';

interface Props {
  /** Heading above the player. */
  heading?: string;
  /** One line under the heading. */
  lead?: string;
  /** Shown on the play button, e.g. "1:58". Omit if you'd rather not commit. */
  duration?: string;
}

const {
  heading = 'Watch it sort the collection — then grow the order.',
  lead = 'Two minutes, no signup: the collection re-ranks itself on live demand, then the same engine goes to work on the basket — upsells learned from how your shoppers buy and browse, re-ranked by why each one came, from the product page to checkout and after it.',
  duration,
} = Astro.props;

const watchUrl = `https://www.youtube.com/watch?v=${INTRO_VIDEO_ID}`;
const embedUrl = `https://www.youtube-nocookie.com/embed/${INTRO_VIDEO_ID}?autoplay=1&rel=0&playsinline=1&enablejsapi=1`;
---

<section class="sec alt" style="padding-top:0">
  <div class="wrap">
    <div class="shead ctr shead-lg rv" style="margin-bottom:2rem">
      <h2>{heading}</h2>
      <p class="lead-c">{lead}</p>
    </div>

    <div class="vplayer rv" id="introVideo" data-embed={embedUrl}>
      <img src="/video/qsortby-intro-youtube.jpg" alt="" width="1280" height="720" loading="lazy" decoding="async" />
      <a class="vplay" href={watchUrl} target="_blank" rel="noopener" aria-label="Play the QSortby introduction">
        {/* Reads as a player at a glance: a big play button in the open
            middle of the thumbnail, and a control bar along the bottom edge
            with the running time. */}
        <span class="vbig" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg></span>
        <span class="vbar" aria-hidden="true">
          <svg class="vbar-p" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
          <span class="vbar-t">Watch the intro</span>
          <span class="vtrack"><i></i></span>
          <span class="vtime">0:00{duration && <> / {duration}</>}</span>
        </span>
      </a>
    </div>
  </div>
</section>

<script is:inline>
  // One click handler, no framework. The link stays a working fallback: if
  // this never runs, the button opens the video on YouTube.
  (() => {
    const box = document.getElementById('introVideo');
    const btn = box && box.querySelector('.vplay');
    if (!btn) return;
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      if (window.qsTrack) window.qsTrack('video_play', { video_title: 'QSortby intro' });
      const f = document.createElement('iframe');
      f.src = box.dataset.embed;
      f.title = 'QSortby product introduction';
      f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      f.referrerPolicy = 'strict-origin-when-cross-origin';
      f.allowFullscreen = true;
      box.replaceChildren(f);
      f.focus();
    });
  })();
</script>

<style>
  /* Sized by aspect ratio rather than a fixed height so the frame can't shift
     layout while the poster loads. */
  .vplayer {
    position: relative;
    max-width: 900px;
    margin-inline: auto;
    aspect-ratio: 16 / 9;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--grad-mint);
    box-shadow: 0 30px 60px -40px rgba(16, 24, 40, 0.35);
  }
  /* `:global` on the iframe is load-bearing: it is created by the click
     handler, so it never gets Astro's scoped-style attribute and a plain
     `.vplayer iframe` rule would not match it — it would render at the
     browser default 300×150 in the corner of the frame. */
  .vplayer img,
  .vplayer :global(iframe) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
  }

  /* The overlay covers the whole frame (the entire poster is the play
     target), but the visible button is one pill at the bottom centre: the
     YouTube thumbnail is a designed frame with copy and a product card, and
     a button in the middle would sit on top of them. */
  .vplay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: clamp(14px, 4%, 30px);
    background: transparent;
    cursor: pointer;
    font: inherit;
    text-decoration: none;
  }
  .vplay-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px 7px 7px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--bg);
    box-shadow: 0 12px 28px -12px rgba(30, 30, 26, 0.55);
    transition: transform 0.18s ease, background 0.18s ease;
  }
  .vplay-ring {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--green);
  }
  .vplay-ring svg {
    width: 14px;
    height: 14px;
    fill: #fff;
    margin-left: 2px;
  }
  .vplay-txt {
    font-size: 13.5px;
    font-weight: 600;
    white-space: nowrap;
  }
  .vplay-dur {
    font-weight: 500;
    opacity: 0.6;
  }
  .vplay:hover .vplay-pill,
  .vplay:focus-visible .vplay-pill {
    transform: translateY(-2px);
    background: var(--btn-h);
  }
  .vplay:focus-visible {
    outline: none;
  }
  .vplay:focus-visible .vplay-pill {
    outline: 2px solid var(--green);
    outline-offset: 3px;
  }
  @media (max-width: 560px) {
    .vplay { padding-bottom: 10px; }
    .vplay-pill { gap: 7px; padding: 4px 12px 4px 4px; }
    .vplay-ring { width: 24px; height: 24px; }
    .vplay-ring svg { width: 11px; height: 11px; }
    .vplay-txt { font-size: 11.5px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .vplay-pill {
      transition: none;
    }
    .vplay:hover .vplay-pill,
    .vplay:focus-visible .vplay-pill {
      transform: none;
    }
  }

  /* ---- player affordances (2026-11) ---- */
  .vplayer img { transition: transform 0.5s ease; }
  .vplay { align-items: center; padding-bottom: 0; }
  .vplay::before {
    content: ""; position: absolute; inset: 0; background: rgba(16, 24, 20, 0); transition: background 0.25s ease;
  }
  .vplay:hover::before { background: rgba(16, 24, 20, 0.08); }
  .vplayer:hover img { transform: scale(1.015); }
  .vbig {
    position: relative; display: grid; place-items: center; width: 76px; height: 76px; border-radius: 50%;
    background: var(--green); color: #fff;
    box-shadow: 0 18px 40px -14px rgba(0, 120, 80, 0.7), 0 0 0 10px rgba(0, 163, 107, 0.16);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .vbig::after {
    content: ""; position: absolute; inset: -10px; border-radius: 50%; border: 2px solid rgba(0, 163, 107, 0.45);
    animation: vring 2.4s ease-out infinite;
  }
  .vbig svg { width: 28px; height: 28px; fill: #fff; margin-left: 4px; }
  .vplay:hover .vbig, .vplay:focus-visible .vbig { transform: scale(1.07); box-shadow: 0 20px 44px -14px rgba(0, 120, 80, 0.8), 0 0 0 14px rgba(0, 163, 107, 0.2); }
  @keyframes vring { 0% { transform: scale(0.9); opacity: 0.9; } 100% { transform: scale(1.35); opacity: 0; } }
  .vbar {
    position: absolute; left: 0; right: 0; bottom: 0; display: flex; align-items: center; gap: 14px;
    padding: 34px 22px 16px; color: #fff; font-size: 13px; font-weight: 600;
    background: linear-gradient(180deg, transparent, rgba(12, 20, 16, 0.62));
  }
  .vbar-p { width: 16px; height: 16px; fill: #fff; flex: none; }
  .vbar-t { white-space: nowrap; }
  .vtrack { position: relative; flex: 1; height: 4px; border-radius: 2px; background: rgba(255, 255, 255, 0.35); overflow: hidden; }
  .vtrack i { position: absolute; inset: 0 auto 0 0; width: 3%; background: var(--green-bright, #2bd996); border-radius: 2px; }
  .vtime { font-family: var(--mono); font-variant-numeric: tabular-nums; font-weight: 500; opacity: 0.9; white-space: nowrap; }
  @media (max-width: 560px) {
    .vbig { width: 60px; height: 60px; }
    .vbig svg { width: 22px; height: 22px; }
    .vbar { padding: 24px 14px 10px; gap: 10px; font-size: 12px; }
    .vbar-t { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .vbig::after { animation: none; } .vplayer img { transition: none; } }

  /* Play button dead centre of the frame. */
  .vbig { position: absolute; left: 50%; top: 50%; translate: -50% -50%; }
</style>
