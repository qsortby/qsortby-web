  .us-fill { display:block; height:100%; width:0%; border-radius:3px;
    background:linear-gradient(90deg,var(--green),var(--green-bright));
    transition:width .6s var(--ease) .2s; }
  .us-scene.active .us-fill { width:74%; }

  /* order summary — neutral (not green): it's existing page content, not the
     block that got added, so it reads distinct from `.us-block` below it */
  .us-summary { padding:12px 13px; border-radius:12px; background:var(--bg-2); border:1px solid var(--line); }
  .us-summary .offer-cartrow { background:var(--surface); }
  .us-total { display:flex; align-items:center; justify-content:space-between; margin-top:8px;
    padding-top:8px; border-top:1px solid var(--line); font-size:.85rem; color:var(--ink); }
  .us-total b { font-family:var(--mono); }

  .us-confirm { display:flex; align-items:center; gap:8px; font-size:.92rem; font-weight:650; color:var(--ink); }
  .us-confirm svg { width:18px; height:18px; flex:none; fill:none; stroke:var(--green-ink); stroke-width:2.6; }

  @media (prefers-reduced-motion:reduce){
    .us-scene, .us-modal, .us-drawer, .us-fill { animation:none!important; transition:none!important; }
  }

  /* Personalization: rows are the controls for the illustration's scenes. */
  button.offer-row { width:100%; text-align:left; background:none; border:0; border-top:1px solid var(--line);
    font:inherit; color:inherit; cursor:pointer; border-radius:0; position:relative; }
  button.offer-row:first-child { border-top:0; }
  button.offer-row .offer-arrow { font-family:var(--mono); font-size:12px; letter-spacing:.06em; padding-top:3px;
    color:var(--faint); transition:color .18s var(--ease); }
  button.offer-row p { transition:color .18s var(--ease); }
  button.offer-row[aria-selected="false"] p { color:var(--muted); }
  button.offer-row[aria-selected="true"] .offer-arrow,
  button.offer-row[aria-selected="true"] b { color:var(--green-ink); }
  button.offer-row:hover b { color:var(--green-ink); }
  button.offer-row:focus-visible { outline:2px solid var(--green); outline-offset:4px; border-radius:6px; }

  /* One frame for all three scenes: they share one grid cell, so the card
     never changes height when a row is clicked. */
  .pz-stage { justify-content:flex-start; gap:16px; }
  .pz-steps { list-style:none; margin:0; padding:0; display:flex; gap:6px; }
  .pz-steps li { flex:1; display:flex; align-items:center; gap:8px; padding:8px 10px; border-radius:10px;
    font-family:var(--mono); font-size:10.5px; font-weight:700; letter-spacing:.08em; text-transform:uppercase;
    color:rgba(255,255,255,.4); background:rgba(255,255,255,.04); transition:all .2s var(--ease); }
  .pz-steps li b { display:grid; place-items:center; width:18px; height:18px; border-radius:50%; font-size:10px;
    background:rgba(255,255,255,.1); color:rgba(255,255,255,.6); }
  .pz-steps li.on { color:#fff; background:rgba(0,163,107,.18); }
  .pz-steps li.on b { background:var(--green-bright); color:#06140E; }

  .pz-visitor { display:flex; align-items:center; gap:12px; padding:12px 14px; border-radius:13px;
    background:rgba(255,255,255,.06); border:1px solid rgba(120,220,170,.18); }
  .pz-av { flex:none; display:grid; place-items:center; width:36px; height:36px; border-radius:50%;
    background:rgba(255,255,255,.08); }
  .pz-av svg { width:20px; height:20px; fill:none; stroke:rgba(255,255,255,.75); stroke-width:1.8; stroke-linecap:round; }
  .pz-vt { flex:1; min-width:0; display:flex; flex-direction:column; }
  .pz-vt b { font-size:.92rem; font-weight:650; color:#fff; }
  .pz-vt small { font-size:.8rem; color:rgba(255,255,255,.6); }
  .pz-vtag { flex:none; font-family:var(--mono); font-size:10px; font-weight:700; letter-spacing:.06em;
    text-transform:uppercase; color:#06140E; background:var(--green-bright); border-radius:999px; padding:4px 10px;
    transition:opacity .2s var(--ease); }
  .pz-stage[data-at="match"] .pz-vtag { opacity:0; }

  .pz-body { display:grid; flex:1; }
  .pz-scene { grid-area:1 / 1; visibility:hidden; opacity:0; transition:opacity .25s var(--ease);
    display:flex; flex-direction:column; justify-content:center; }
  .pz-scene.active { visibility:visible; opacity:1; }
  @media (prefers-reduced-motion:reduce){ .pz-scene { transition:none; } }
  .pz-k { display:block; font-family:var(--mono); font-size:10.5px; font-weight:700; letter-spacing:.1em;
    text-transform:uppercase; color:rgba(255,255,255,.45); margin-bottom:12px; }
  .pz-cap { margin-top:14px; text-align:center; font-size:.82rem; color:rgba(255,255,255,.55); }

  .pz-types { display:flex; flex-direction:column; gap:8px; }
  .pz-type { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:10px 14px;
    border-radius:12px; border:1px solid rgba(255,255,255,.07); opacity:.42; }
  .pz-tn { display:flex; flex-direction:column; font-size:.95rem; font-weight:650; color:#fff; }
  .pz-tn small { font-size:.78rem; font-weight:400; color:rgba(255,255,255,.6); }
  .pz-type.on { opacity:1; background:rgba(0,163,107,.18); border-color:rgba(120,220,170,.55); }
  .pz-ok { flex:none; font-family:var(--mono); font-size:10.5px; font-weight:700; letter-spacing:.06em;
    text-transform:uppercase; color:#06140E; background:var(--green-bright); border-radius:999px; padding:4px 10px; }

  .pz-bars { display:flex; flex-direction:column; gap:16px; }
  .pz-bar { display:grid; grid-template-columns:150px 1fr 36px; align-items:center; gap:14px; }
  .pz-bar span { font-size:.95rem; font-weight:600; color:#fff; }
  .pz-bar i { display:block; height:12px; border-radius:7px; background:rgba(255,255,255,.08); overflow:hidden; }
  .pz-bar i b { display:block; height:100%; border-radius:7px; background:linear-gradient(90deg,var(--green),var(--green-bright)); }
  .pz-bar em { font-style:normal; font-family:var(--mono); font-size:.85rem; font-weight:700; color:var(--green-bright);
    text-align:right; }

  .pz-feed { display:flex; flex-direction:column; gap:8px; }
  .pz-fl { font-size:.8rem; font-weight:600; color:rgba(255,255,255,.7); }
  .pz-fl + .pz-tiles + .pz-fl { margin-top:6px; }
  .pz-tiles { display:grid; grid-template-columns:repeat(4, 1fr); gap:8px; }
  .pz-tile { position:relative; display:flex; flex-direction:column; align-items:center; gap:6px; padding:10px 6px 9px;
    border-radius:11px; background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.08); min-width:0; }
  .pz-tile small { width:100%; text-align:center; font-size:.72rem; color:rgba(255,255,255,.75); white-space:nowrap;
    overflow:hidden; text-overflow:ellipsis; }
  .pz-tiles:not(.on) .pz-tile { opacity:.5; }
  .pz-tile.hit { background:rgba(0,163,107,.18); border-color:rgba(120,220,170,.55); }
  .pz-tile em { position:absolute; top:-8px; right:6px; font-style:normal; font-family:var(--mono); font-size:8.5px;
    font-weight:700; letter-spacing:.06em; text-transform:uppercase; color:#06140E; background:var(--green-bright);
    border-radius:999px; padding:2px 6px; }

  @media (max-width:560px){
    .pz-visitor { flex-wrap:wrap; row-gap:8px; }
    .pz-vt { flex:1 1 calc(100% - 48px); }
    .pz-vtag { margin-left:48px; }
    .pz-stage[data-at="match"] .pz-vtag { display:none; }
    .pz-steps li { justify-content:center; padding:7px 6px; }
    .pz-bar { grid-template-columns:1fr 36px; gap:6px 10px; }
    .pz-bar i { grid-column:1 / -1; grid-row:2; }
    .pz-tile small { display:none; }
  }

  @media (max-width:640px){
    .offer-tabs { width:100%; }
    .offer-tabs button { flex:1; padding:9px 8px; }
  }
</style>

<script>
  const tabsEl = document.getElementById('offer-tabs');
  if (tabsEl) {
    const buttons = Array.from(tabsEl.querySelectorAll('button'));
    const panels = Array.from(document.querySelectorAll('.offer-panel')) as HTMLElement[];
    buttons.forEach((b) => {
      b.addEventListener('click', () => {
        buttons.forEach((x) => x.setAttribute('aria-selected', String(x === b)));
        panels.forEach((p) => { p.hidden = p.dataset.panel !== b.getAttribute('data-tab'); });
      });
    });
  }

  // Personalization: each claim row shows its own scene.
  const pzRows = Array.from(document.querySelectorAll('.pz-row'));
  const pzScenes = Array.from(document.querySelectorAll('.pz-scene')) as HTMLElement[];
  pzRows.forEach((row) => {
    row.addEventListener('click', () => {
      const key = row.getAttribute('data-pz');
      pzRows.forEach((r) => r.setAttribute('aria-selected', String(r === row)));
      pzScenes.forEach((s) => {
        const on = s.dataset.pzScene === key;
        s.classList.toggle('active', on);
        s.setAttribute('aria-hidden', String(!on));
      });
      const stageEl = document.querySelector('.pz-stage') as HTMLElement | null;
      if (stageEl && key) stageEl.dataset.at = key;
      document.querySelectorAll('.pz-steps li').forEach((li) => li.classList.toggle('on', li.getAttribute('data-step') === key));
      // Below 900px the picture sits under the rows; bring it into view so
      // the click visibly does something.
      const stage = document.querySelector('.pz-stage');
      if (stage && window.matchMedia('(max-width: 899px)').matches) {
        const r = stage.getBoundingClientRect();
        if (r.top > window.innerHeight * 0.6 || r.bottom < 0) stage.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });
  });

  const tpChips = Array.from(document.querySelectorAll('.us-chip'));
  const scenes = Array.from(document.querySelectorAll('.us-scene')) as HTMLElement[];
  const urlEl = document.getElementById('us-url');
  tpChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      tpChips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      scenes.forEach((s) => s.classList.toggle('active', s.dataset.scene === chip.getAttribute('data-tp')));
      if (urlEl) urlEl.textContent = 'your-store.com' + chip.getAttribute('data-path');
    });
  });
</script>
