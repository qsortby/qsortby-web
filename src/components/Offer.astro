---
// "What you get" overview — three jobs, one engine. Sits right under the intro
// video: a visitor who just watched the whole journey (sort → cart → checkout)
// lands here to see the three buckets that journey came from, each with its
// own short case and a picture. Tabs default to Merchandising; all three
// panels render in markup (SSR) so a no-JS visitor still gets the first one
// complete rather than an empty shell — the script only toggles which is shown.

/** `scene` makes the row a button that switches the illustration to that
 *  scene (the Personalization tab — one picture per claim, same idea as the
 *  Upsell tab's touchpoint chips). Rows without it are plain text. */
interface Row { title: string; desc: string; scene?: string; }
interface Tab { key: string; label: string; sub: string; rows: Row[]; }

// Ordered by where a shopper actually meets them, browse → cart → checkout →
// post-purchase — not alphabetically, not by tier. Drives both the chip list
// in the copy and the matching scene in the illustration (data-tp ↔ data-scene).
const TOUCHPOINTS = [
  { key: 'product', label: 'Product page', path: '/products/trail-runner' },
  { key: 'fbt', label: 'Frequently bought together', path: '/products/trail-runner' },
  { key: 'popup', label: 'Pop-up', path: '/collections/new-in' },
  { key: 'cart', label: 'Cart drawer', path: '/cart' },
  { key: 'shipbar', label: 'Free-shipping progress bar', path: '/cart' },
  { key: 'checkout', label: 'Checkout page', path: '/checkout' },
  { key: 'thankyou', label: 'Thank-you page', path: '/thank-you' },
];

// Personalization scenes — ONE visitor followed through the three steps, so
// the three pictures read as a sequence rather than three diagrams. Names,
// conditions, order and weights are the app's defaults
// (apps/api/src/lib/personalize/config.ts). The visitor also meets
// "Returning visitor", which is the point: the first match wins.
const PZ_TYPES = [
  { name: 'Customer', cond: 'Orders placed ≥ 1' },
  { name: 'Cart abandoner', cond: 'Cart ≥ 1 item', match: true },
  { name: 'Returning visitor', cond: 'Visits ≥ 2' },
  { name: 'New visitor', cond: 'Everyone else' },
];
const PZ_FORMULA: [string, number][] = [['Cart history', 0.5], ['Session intent', 0.3], ['Favorite category', 0.2]];
const PZ_NAMES: Record<string, string> = { watch: 'Field Watch', headphones: 'Studio Headphones', tee: 'Everyday Tee', sneaker: 'Trail Runner' };
// The Field Watch is in this visitor's cart, and Cart history leads their formula.
const PZ_THIS = ['watch', 'headphones', 'tee', 'sneaker'];
const PZ_NEW = ['tee', 'sneaker', 'headphones', 'watch'];
const PZ_STEPS: [string, string][] = [['match', 'Match'], ['formula', 'Rank'], ['feed', 'Show']];

const TABS: Tab[] = [
  {
    key: 'merch',
    label: 'Merchandising',
    sub: 'Automated collection sorting for Shopify — data-driven, not manual.',
    rows: [
      { title: 'Live sorting, tested and attributed', desc: 'Collections re-rank continuously on live signals like sales, margin, conversion and stock, then run as A/B tests against the current order, with attributed revenue behind every result.' },
      { title: 'Grouping by your own rules', desc: 'Products follow the grouping rules you define, by vendor, product type or tag, staying together in the order you set within each group as the collection re-sorts.' },
      { title: 'Decisions backed by real behavior', desc: 'Every sort is evaluated against real shopper behavior, including clicks, add-to-carts and purchases, grounding each merchandising decision in data rather than guesswork.' },
    ],
  },
  {
    key: 'personalize',
    label: 'Personalization',
    sub: 'Personalization from the first visit — no login, no purchase history required.',
    rows: [
      { scene: 'match', title: 'Visitor types, from what the store can see', desc: 'Each visitor is matched to the first type whose conditions they meet — visits, days since the last one, orders placed, what is in the cart.' },
      { scene: 'formula', title: 'A ranking formula for each type', desc: 'Each type ranks by its own weighted signals — top sellers, new arrivals, cart history, what they came for. You set the weights.' },
      { scene: 'feed', title: 'A For You block that ranks per visitor', desc: 'Add the For You block to any page in the theme editor. Each visitor sees the order their type’s formula gives.' },
    ],
  },
  {
    key: 'upsell',
    label: 'Upsell',
    sub: 'Add upsell blocks to any touchpoint, and personalize what they recommend.',
    rows: [
      { title: 'Add upsell blocks anywhere', desc: 'Add a block to the cart drawer, checkout, thank-you page, home or product page, and set the rule it follows — frequently bought together, best sellers, or trending.' },
      { title: 'Personalize what each block recommends', desc: 'Show different products to each shopper based on their browsing behavior, session activity, and what’s actually selling.' },
    ],
  },
];
---
<section class="sec offersec" style="padding-top:0">
  <div class="wrap">
    <div class="shead ctr shead-lg rv" style="margin-bottom:2.25rem">
      <h2>From sorting to selling, <em>powered by one engine.</em></h2>
    </div>

    <div class="offer rv">
      <div class="offer-tabs" id="offer-tabs" role="tablist" aria-label="What QSortby does">
        {TABS.map((t, i) => (
          <button data-tab={t.key} role="tab" aria-selected={i === 0}>{t.label}</button>
        ))}
      </div>

      {TABS.map((t, i) => (
        <div class="offer-panel" data-panel={t.key} hidden={i !== 0}>
          <div class="offer-grid">
            <div class="offer-copy">
              <p class="offer-sub">{t.sub}</p>

              {t.key === 'upsell' && (
                <div class="offer-tp">
                  <span class="offer-ck">Try a touchpoint</span>
                  <div class="offer-chips" id="tp-chips" role="tablist" aria-label="Upsell touchpoint">
                    {TOUCHPOINTS.map((tp, i) => (
                      <button type="button" class="us-chip" data-tp={tp.key} data-path={tp.path} role="tab" aria-pressed={i === 0}>{tp.label}</button>
                    ))}
                  </div>
                </div>
              )}

              <div class="offer-list" role={t.rows.some((r) => r.scene) ? 'tablist' : undefined} aria-label={t.rows.some((r) => r.scene) ? `${t.label}, step by step` : undefined}>
                {t.rows.map((r, ri) => r.scene ? (
                  <button type="button" class="offer-row pz-row" data-pz={r.scene} role="tab" aria-selected={ri === 0} aria-controls={`pz-${r.scene}`}>
                    <span class="offer-arrow">{String(ri + 1).padStart(2, '0')}</span>
                    <div>
                      <b>{r.title}</b>
                      <p>{r.desc}</p>
                    </div>
                  </button>
                ) : (
                  <div class="offer-row">
                    <span class="offer-arrow">&rarr;</span>
                    <div>
                      <b>{r.title}</b>
                      <p>{r.desc}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <div class="offer-viz">
              {t.key === 'merch' && (
                <div class="offer-card">
                  <span class="offer-ck">Sorting strategy &middot; live</span>
                  <div class="offer-sliders">
                    <div class="offer-sl"><span>Sales</span><i style="--w:75%"></i><b>75</b></div>
                    <div class="offer-sl"><span>Margin</span><i style="--w:40%"></i><b>40</b></div>
                    <div class="offer-sl"><span>Conversion</span><i style="--w:60%"></i><b>60</b></div>
                    <div class="offer-sl"><span>Stock</span><i style="--w:90%"></i><b>90</b></div>
                  </div>
                  <div class="offer-verdict">96% significant &mdash; <b>B wins</b><span class="offer-vtag">Attributed revenue</span></div>

                  <span class="offer-ck" style="margin-top:22px">Grouped &middot; Outerwear</span>
                  <div class="offer-thumbs">
                    <span class="gthumb"><img src="/products/tee.svg" alt="" /></span>
                    <span class="gthumb"><img src="/products/sneaker.svg" alt="" /></span>
                    <span class="gthumb"><img src="/products/cap.svg" alt="" /></span>
                    <span class="gthumb"><img src="/products/tote.svg" alt="" /></span>
                  </div>

                  <span class="offer-ck" style="margin-top:22px">Evaluated against</span>
                  <div class="offer-chips">
                    <span>Clicks</span><span>Add-to-carts</span><span>Purchases</span>
                  </div>
                </div>
              )}
              {t.key === 'personalize' && (
                <div class="offer-card dark pz-stage" data-at="match">
                  <ol class="pz-steps" aria-hidden="true">
                    {PZ_STEPS.map(([k, label], si) => <li data-step={k} class={si === 0 ? 'on' : ''}><b>{si + 1}</b>{label}</li>)}
                  </ol>

                  {/* The same visitor in every scene; their type appears once matched. */}
                  <div class="pz-visitor">
                    <span class="pz-av" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="8.5" r="3.6"/><path d="M5 20c0-3.9 3.1-6.2 7-6.2s7 2.3 7 6.2"/></svg></span>
                    <span class="pz-vt"><b>This visitor</b><small>3 visits · 0 orders · 1 item in cart</small></span>
                    <span class="pz-vtag">Cart abandoner</span>
                  </div>

                  <div class="pz-body">
                    <div class="pz-scene active" id="pz-match" data-pz-scene="match" role="tabpanel">
                      <div class="pz-types">
                        {PZ_TYPES.map((ty) => (
                          <div class={ty.match ? 'pz-type on' : 'pz-type'}>
                            <span class="pz-tn">{ty.name}<small>{ty.cond}</small></span>
                            {ty.match && <span class="pz-ok">✓ Match</span>}
                          </div>
                        ))}
                      </div>
                      <p class="pz-cap">Checked top to bottom &mdash; the first match wins</p>
                    </div>

                    <div class="pz-scene" id="pz-formula" data-pz-scene="formula" role="tabpanel">
                      <span class="pz-k">Cart abandoner ranks by</span>
                      <div class="pz-bars">
                        {PZ_FORMULA.map(([sig, w]) => (
                          <div class="pz-bar">
                            <span>{sig}</span>
                            <i><b style={`width:${w * 100}%`}></b></i>
                            <em>{w.toFixed(1)}</em>
                          </div>
                        ))}
                      </div>
                      <p class="pz-cap">The default weights &mdash; every one is yours to change</p>
                    </div>

                    <div class="pz-scene" id="pz-feed" data-pz-scene="feed" role="tabpanel">
                      <span class="pz-k">For You block</span>
                      <div class="pz-feed">
                        <span class="pz-fl">This visitor</span>
                        <div class="pz-tiles on">
                          {PZ_THIS.map((k, ti) => (
                            <span class={ti === 0 ? 'pz-tile hit' : 'pz-tile'}>
                              <span class="gthumb"><img src={`/products/${k}.svg`} alt="" loading="lazy" decoding="async" /></span>
                              <small>{PZ_NAMES[k]}</small>
                              {ti === 0 && <em>In cart</em>}
                            </span>
                          ))}
                        </div>
                        <span class="pz-fl">A new visitor</span>
                        <div class="pz-tiles">
                          {PZ_NEW.map((k) => (
                            <span class="pz-tile">
                              <span class="gthumb"><img src={`/products/${k}.svg`} alt="" loading="lazy" decoding="async" /></span>
                              <small>{PZ_NAMES[k]}</small>
                            </span>
                          ))}
                        </div>
                      </div>
                      <p class="pz-cap">One block, any page &mdash; each visitor’s own order</p>
                    </div>
                  </div>
                </div>
              )}
              {t.key === 'upsell' && (
                <div class="offer-card us-stage">
                  <div class="us-chrome"><i></i><i></i><i></i><span id="us-url">your-store.com/products/trail-runner</span></div>
                  <div class="us-body">
                    <div class="us-scene active" data-scene="product">
                      <span class="us-loc"><i></i>Product page</span>
                      <div class="us-hero"><span class="us-himg"></span><span class="us-hl"></span><span class="us-hl short"></span></div>
                      <div class="us-block">
                        <span class="us-btag">Upsell block added</span>
                        <div class="us-plist">
                          <div class="us-prow"><span class="gthumb"><img src="/products/cap.svg" alt="" /></span><span class="offer-cn">Classic Cap</span></div>
                          <div class="us-prow"><span class="gthumb"><img src="/products/tote.svg" alt="" /></span><span class="offer-cn">Canvas Tote</span></div>
                        </div>
                      </div>
                    </div>

                    <div class="us-scene" data-scene="fbt">
                      <span class="us-loc"><i></i>Product page</span>
                      <div class="us-hero"><span class="us-himg"></span><span class="us-hl"></span><span class="us-hl short"></span></div>
                      <div class="us-block">
                        <span class="us-btag">Upsell block added</span>
                        <div class="us-bundle">
                          <span class="gthumb"><img src="/products/sneaker.svg" alt="" /></span>
                          <span class="us-plus">+</span>
                          <span class="gthumb"><img src="/products/cap.svg" alt="" /></span>
                          <span class="us-plus">+</span>
                          <span class="gthumb"><img src="/products/tote.svg" alt="" /></span>
                          <span class="us-add">Add all 3</span>
                        </div>
                      </div>
                    </div>

                    <div class="us-scene" data-scene="popup">
                      <div class="us-hero dim">
                        <span class="us-loc muted"><i></i>Collection page</span>
                        <span class="us-himg"></span><span class="us-hl"></span><span class="us-hl short"></span>
                      </div>
                      <div class="us-modal">
                        <span class="us-modalx" aria-hidden="true">&times;</span>
                        <span class="us-btag ctr">Pop-up &middot; Upsell block added</span>
                        <b>Complete the look</b>
                        <div class="us-grid2">
                          <span class="gthumb"><img src="/products/headphones.svg" alt="" /></span>
                          <span class="gthumb"><img src="/products/watch.svg" alt="" /></span>
                          <span class="gthumb"><img src="/products/cap.svg" alt="" /></span>
                          <span class="gthumb"><img src="/products/sneaker.svg" alt="" /></span>
                          <span class="gthumb"><img src="/products/tee.svg" alt="" /></span>
                          <span class="gthumb"><img src="/products/tote.svg" alt="" /></span>
                        </div>
                      </div>
                    </div>

                    <div class="us-scene" data-scene="cart">
                      <span class="us-loc"><i></i>Cart drawer</span>
                      <div class="us-drawer">
                        <span class="us-dtitle">Your cart &middot; 1 item</span>
                        <div class="offer-cartrow"><span class="gthumb"><img src="/products/tee.svg" alt="" /></span><span class="offer-cn">Everyday Tee</span><span class="us-price">$28</span></div>

                        <span class="offer-ck" style="margin:12px 0 8px">Recommended for you</span>
                        <div class="offer-cartrow up"><span class="gthumb"><img src="/products/bottle.svg" alt="" /></span><span class="offer-cn">Steel Bottle</span><span class="us-price">$18</span><span class="us-add">Add</span></div>
                      </div>
                    </div>

                    <div class="us-scene" data-scene="shipbar">
                      <span class="us-loc"><i></i>Cart drawer</span>
                      <div class="us-drawer">
                        <span class="us-dtitle">Your cart</span>
                        <div class="us-shiprow">$12 away from free shipping &mdash; add one:</div>
                        <div class="us-shipbar"><i class="us-fill"></i></div>
                        <div class="offer-cartrow up"><span class="gthumb"><img src="/products/sneaker.svg" alt="" /></span><span class="offer-cn">Trail Runner</span><span class="us-price">$64</span><span class="us-add">Add</span></div>
                        <div class="offer-cartrow up"><span class="gthumb"><img src="/products/bottle.svg" alt="" /></span><span class="offer-cn">Steel Bottle</span><span class="us-price">$18</span><span class="us-add">Add</span></div>
                      </div>
                    </div>

                    <div class="us-scene" data-scene="checkout">
                      <span class="us-loc"><i></i>Checkout page</span>
                      <div class="us-summary">
                        <span class="offer-ck">Order summary</span>
                        <div class="offer-cartrow"><span class="gthumb"><img src="/products/tee.svg" alt="" /></span><span class="offer-cn">Everyday Tee</span><span class="us-price">$28</span></div>
                        <div class="us-total"><span>Total</span><b>$28</b></div>
                      </div>
                      <div class="us-block">
                        <span class="us-btag">Recommended for you</span>
                        <div class="offer-cartrow"><span class="gthumb"><img src="/products/candle-tin.svg" alt="" /></span><span class="offer-cn">Travel Candle</span><span class="us-price">$9</span><span class="us-add">Add</span></div>
                      </div>
                    </div>

                    <div class="us-scene" data-scene="thankyou">
                      <span class="us-loc"><i></i>Thank-you page</span>
                      <div class="us-confirm"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg> Order #1042 confirmed</div>
                      <div class="us-block">
                        <span class="us-btag">Upsell block added</span>
                        <div class="offer-cartrow"><span class="gthumb"><img src="/products/mug.svg" alt="" /></span><span class="offer-cn">20% off your next order</span></div>
                      </div>
                    </div>
                  </div>
                </div>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .offer { width:100%; }
  .offer-tabs { display:flex; width:fit-content; background:var(--bg-2); border:1px solid var(--line);
    border-radius:999px; padding:4px; margin:0 auto 2rem; }
  .offer-tabs button { font-family:var(--font-sans); font-size:.9rem; font-weight:600;
    color:var(--ink-2); background:none; border:0; border-radius:999px; padding:9px 20px;
    cursor:pointer; transition:all .2s var(--ease); white-space:nowrap; }
  .offer-tabs button[aria-selected="true"] { background:var(--ink); color:#fff; }

  .offer-grid { display:grid; gap:2.5rem; align-items:stretch; }
  @media (min-width:900px){ .offer-grid { grid-template-columns:.85fr 1.15fr; gap:3.5rem; } }

  /* The card fills the row's full height (matching the copy column) and
     centers its own content in it, so the two sides stay visually balanced
     regardless of how long either one's content is. */
  .offer-viz { display:flex; }
  .offer-card { flex:1; display:flex; flex-direction:column; justify-content:center; }

  .offer-sub { font-size:1.125rem; color:var(--ink-2); line-height:1.625; margin-bottom:1.75rem; }
  .offer-list { display:flex; flex-direction:column; }
  .offer-row { display:flex; gap:12px; padding:1.1rem 0; border-top:1px solid var(--line); }
  .offer-row:first-child { border-top:0; padding-top:0; }
  .offer-arrow { flex:none; color:var(--green-ink); font-weight:700; line-height:1.5; }
  .offer-row b { display:block; font-weight:650; font-size:1.02rem; color:var(--ink);
    letter-spacing:-.012em; margin-bottom:5px; }
  .offer-row p { font-size:1rem; line-height:var(--lh-body); color:var(--ink-2); }

  .offer-card { background:var(--surface); border:1px solid var(--line); border-radius:18px;
    padding:22px; box-shadow:0 1px 2px rgba(16,24,40,.04), 0 24px 48px -30px rgba(16,24,40,.25); }
  .offer-card.dark { background:linear-gradient(165deg,#123227,#08160F);
    border-color:rgba(120,220,170,.16); }
  .offer-card.dark .pfeeds { margin-top:0; }
  .offer-card.dark .offer-ck { color:rgba(255,255,255,.42); }
  .offer-card.dark .offer-chips span { background:rgba(255,255,255,.06);
    border-color:rgba(120,220,170,.18); color:rgba(255,255,255,.75); }
  .offer-ck { display:block; font-family:var(--mono); font-size:12px; font-weight:700;
    letter-spacing:.1em; text-transform:uppercase; color:var(--muted); margin-bottom:13px; }

  .offer-verdict { display:flex; align-items:center; gap:8px; margin-top:12px;
    font-family:var(--mono); font-size:11px; color:var(--muted); }
  .offer-verdict b { color:var(--green-ink); }
  .offer-vtag { margin-left:auto; font-size:10px; font-weight:700; color:var(--green-ink);
    background:var(--green-soft); border-radius:999px; padding:3px 9px; }

  .offer-sliders { display:grid; gap:12px; }
  .offer-sl { display:grid; grid-template-columns:82px 1fr 28px; align-items:center; gap:10px; }
  .offer-sl span { font-size:.82rem; color:var(--ink-2); }
  .offer-sl i { display:block; height:7px; border-radius:4px; background:var(--line); position:relative; overflow:hidden; }
  .offer-sl i::before { content:""; position:absolute; inset:0; width:var(--w); border-radius:4px;
    background:linear-gradient(90deg,var(--green),var(--green-bright)); }
  .offer-sl b { font-family:var(--mono); font-size:.8rem; font-weight:700; color:var(--ink);
    text-align:right; font-variant-numeric:tabular-nums; }

  .offer-thumbs { display:flex; gap:8px; }
  .offer-thumbs .gthumb { width:38px; height:38px; border-radius:9px; }

  .offer-chips { display:flex; flex-wrap:wrap; gap:7px; }
  .offer-chips span, .offer-chips button { font-family:var(--mono); font-size:13px; font-weight:600;
    color:var(--ink-2); background:var(--bg-2); border:1px solid var(--line); border-radius:999px;
    padding:6px 12px; }
  .offer-chips span.on { background:var(--green-soft); border-color:var(--green-line); color:var(--green-ink); }

  .offer-tp { margin-bottom:1.75rem; padding-bottom:1.5rem; border-bottom:1px solid var(--line); }
  .us-chip { cursor:pointer; transition:all .18s var(--ease); }
  .us-chip:hover { border-color:var(--green-line); color:var(--green-ink); }
  .us-chip[aria-pressed="true"] { background:var(--green-soft); border-color:var(--green-line); color:var(--green-ink); }

  .offer-cartrow { display:flex; align-items:center; gap:10px; padding:9px 10px; border-radius:11px;
    background:var(--bg-2); border:1px solid var(--line); margin-bottom:8px; }
  .offer-cartrow:last-child { margin-bottom:0; }
  .offer-cn { flex:1; font-size:.86rem; font-weight:600; color:var(--ink); white-space:nowrap;
    overflow:hidden; text-overflow:ellipsis; }
  .offer-cartrow.up { background:var(--green-soft); border-color:var(--green-line); }
  .us-price { flex:none; font-family:var(--mono); font-size:.78rem; color:var(--muted); margin-left:8px; }

  /* ---- upsell stage — a tiny "browser" whose body swaps scenes ----
     One scene per touchpoint, all in the DOM (so the illustration is complete
     even with JS off — the first shows), absolutely stacked in `.us-body` so
     switching never reflows the card. `.active` drives a fade + rise; a couple
     of scenes (popup, cart) get their own extra motion on top for variety. */
  .us-stage { padding:16px; }
  .us-chrome { display:flex; align-items:center; gap:6px; padding-bottom:12px; margin-bottom:12px;
    border-bottom:1px solid var(--line); }
  .us-chrome i { width:7px; height:7px; border-radius:50%; background:var(--line); }
  .us-chrome span { margin-left:6px; font-family:var(--mono); font-size:10px; color:var(--muted); }

  .us-body { position:relative; height:280px; overflow:hidden; }
  .us-scene { position:absolute; inset:0; display:flex; flex-direction:column; gap:10px;
    opacity:0; transform:translateY(10px) scale(.98); transition:opacity .35s var(--ease), transform .35s var(--ease);
    pointer-events:none; }
  .us-scene.active { opacity:1; transform:none; pointer-events:auto; }

  /* the location label — the whole point of this rework: every scene says,
     unambiguously, where it is before it says what got added there */
  .us-loc { display:flex; align-items:center; gap:6px; flex:none; font-size:.82rem;
    font-weight:700; color:var(--ink); }
  .us-loc i { width:6px; height:6px; border-radius:50%; background:var(--green); flex:none; }
  .us-loc.muted { font-size:.72rem; font-weight:600; color:var(--muted); }
  .us-loc.muted i { background:var(--faint); }

  .us-hero { display:flex; flex-direction:column; gap:7px; }
  .us-hero.dim { opacity:.4; filter:blur(.3px); gap:9px; }
  .us-himg { width:64px; height:64px; border-radius:10px; background:#f1efe9; }
  .us-hl { display:block; height:8px; border-radius:4px; background:var(--line); width:70%; }
  .us-hl.short { width:38%; }

  /* the green box is the "added block" signal — everything inside it reads as
     new; nothing inside also gets its own green fill, or the highlight loses
     meaning (two greens read as "no contrast" rather than "look here"). */
  .us-block { margin-top:auto; padding:12px 13px; border-radius:12px; background:var(--green-soft);
    border:1px solid var(--green-line); }
  .us-btag { display:block; font-family:var(--mono); font-size:9.5px; font-weight:700;
    letter-spacing:.1em; text-transform:uppercase; color:var(--green-ink); margin-bottom:9px; }
